import { LineEdit, Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ScrollIndicator } from "scrollindicator.slint";
import { FocusButton } from "focusbutton.slint";

// One row of the list: `kind` 0 a section heading, 1 an app's card, 2 a process row inside an
// expanded card (crate::view::RowKind).
export struct RowData {
    id: int, kind: int, depth: int, name: string, count: string,
    // An app card's second line: its process count, or its hang.
    sub: string,
    cpu: string, mem: string, disk: string, gpu: string, net: string,
    // Each column's bar under an app card's number, 0..1, in column order.
    bars: [float],
    hung: string, expandable: bool, expanded: bool, actionable: bool,
    // The app or process went away while the list was frozen: shown in place, dimmed, inert.
    exited: bool,
    // The program's icon, extracted off the UI thread; has-icon is false until it arrives (and for
    // the Windows group, headings and images without one).
    icon: image, has-icon: bool,
    // The Windows group: the Windows glyph instead of a program icon.
    windows: bool,
    // The last process row of an expanded card: the card closes below it.
    last-in-card: bool,
    // A process row's PID, shown muted after its name; empty on cards and headings.
    pid: string,
    // Optional table columns.
    col-pid: string,
    col-proc-name: string,
    col-status: string,
    col-threads: string,
    col-handles: string,
    col-publisher: string,
    restrained: bool,
}

// Column geometry shared by the header and every row, so each number sits under its header.
global Columns {
    out property <length> number: 86px;
    out property <length> gap: 8px;
    // The track each app card's bar fills, right-aligned under its number.
    out property <length> bar: 70px;
    // A row's content inset from the card's left edge, and from its right edge.
    out property <length> left: 10px;
    out property <length> right: 12px;
}

// One number in a row, right-aligned (Segoe UI's figures are tabular by default), with an app
// card's bar under it (`bar` < 0: none). Flat, its geometry worked out here rather than by a nested
// layout: five of these in every card on screen are drawn again with each frame. The number and
// its bar, 4 px apart, are centred together.
component NumCell inherits Rectangle {
    in property <string> text;
    in property <bool> strong;
    in property <length> size: 13px;
    in property <float> bar: -1;
    property <bool> has-bar: root.bar >= 0;
    property <length> bar-height: 3px;
    property <length> bar-gap: 4px;
    width: Columns.number;
    number := Text {
        x: 0;
        y: (root.height - self.height - (root.has-bar ? root.bar-gap + root.bar-height : 0px)) / 2;
        width: root.width;
        height: self.preferred-height;
        text: root.text;
        horizontal-alignment: right;
        font-size: root.size;
        color: Theme.text;
        font-weight: root.strong ? 600 : 400;
    }
    // The bar's track and its fill, right-aligned under the number.
    Rectangle {
        visible: root.has-bar;
        x: root.width - Columns.bar;
        y: number.y + number.height + root.bar-gap;
        width: Columns.bar;
        height: root.bar-height;
        border-radius: 1.5px;
        background: Theme.card-border;
    }
    Rectangle {
        visible: root.has-bar;
        x: root.width - Columns.bar;
        y: number.y + number.height + root.bar-gap;
        width: Columns.bar * clamp(root.bar, 0, 1);
        height: root.bar-height;
        border-radius: 1.5px;
        background: Theme.accent;
    }
}

component OptTextCell inherits Rectangle {
    in property <string> text;
    in property <length> size: 12.5px;
    in property <bool> right-align: false;
    Text {
        x: 0;
        y: (root.height - self.height) / 2;
        width: root.width;
        height: self.preferred-height;
        text: root.text;
        horizontal-alignment: root.right-align ? right : left;
        font-size: root.size;
        color: Theme.muted;
        overflow: elide;
    }
}

// Drawn, not a glyph: Segoe UI Variable lacks U+25B8/U+25BE, which rendered as tofu.
component Chevron inherits Rectangle {
    in property <bool> open;
    width: 14px;
    Path {
        width: 8px;
        height: 8px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 8;
        viewbox-height: 8;
        commands: root.open ? "M 0 2 L 4 6 L 8 2" : "M 2 0 L 6 4 L 2 8";
        stroke: Theme.muted;
        stroke-width: 1.5px;
        fill: transparent;
    }
}

// A row's program icon; the Windows group's glyph; or, for anything without an icon (none yet, a
// monochrome one, none at all), a generic program window.
export component RowIcon inherits Rectangle {
    in property <image> source;
    in property <bool> has-icon;
    in property <bool> windows;
    in property <length> size: 24px;
    // As tall as its row; the icon is centred in it.
    width: root.size;
    if root.windows : windows-glyph := Path {
        width: root.size * 0.75;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 0 0 L 7.4 0 L 7.4 7.4 L 0 7.4 Z M 8.6 0 L 16 0 L 16 7.4 L 8.6 7.4 Z M 0 8.6 L 7.4 8.6 L 7.4 16 L 0 16 Z M 8.6 8.6 L 16 8.6 L 16 16 L 8.6 16 Z";
        fill: Theme.accent;
    }
    if !root.windows && root.has-icon : icon-image := Image {
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        source: root.source;
        image-fit: contain;
    }
    if !root.windows && !root.has-icon : generic-glyph := Path {
        width: root.size * 0.75;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 16;
        viewbox-height: 16;
        // A window: its frame and its title bar.
        commands: "M 1.5 2.5 L 14.5 2.5 L 14.5 13.5 L 1.5 13.5 Z M 1.5 5.5 L 14.5 5.5";
        stroke: Theme.muted;
        stroke-width: 1.2px;
        fill: transparent;
    }
}

// One horizontal slice of a card: a whole card, the head of an expanded one, a process strip, or
// the strip that closes it. Where the card goes on past an edge (`open-top`, `open-bottom`) that
// edge has no border and no rounding: the outline is drawn past it and clipped, so only the sides
// show. A closed slice (a plain card: every card on screen while none is expanded) is just this
// one rectangle, with no clip and no inner ones, as each is drawn again with every frame.
component CardSlice inherits Rectangle {
    in property <bool> open-top;
    in property <bool> open-bottom;
    in property <brush> fill;
    in property <brush> edge;
    // Laid over the fill inside the border while `tinted` (the process strip's darker shade).
    in property <brush> tint;
    in property <bool> tinted;
    property <bool> open: root.open-top || root.open-bottom;
    property <length> past: 2px;
    property <length> top-radius: root.open-top ? 0px : Theme.radius;
    property <length> bottom-radius: root.open-bottom ? 0px : Theme.radius;
    background: root.open ? transparent : root.fill;
    border-width: root.open ? 0px : 1px;
    border-color: root.edge;
    border-radius: root.open ? 0px : Theme.radius;
    clip: root.open;
    if root.open : Rectangle {
        y: root.open-top ? -root.past : 0px;
        height: root.height + (root.open-top ? root.past : 0px) + (root.open-bottom ? root.past : 0px);
        background: root.fill;
        border-width: 1px;
        border-color: root.edge;
        border-top-left-radius: root.top-radius;
        border-top-right-radius: root.top-radius;
        border-bottom-left-radius: root.bottom-radius;
        border-bottom-right-radius: root.bottom-radius;
        if root.tinted : Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            background: root.tint;
            border-top-left-radius: max(0px, root.top-radius - 1px);
            border-top-right-radius: max(0px, root.top-radius - 1px);
            border-bottom-left-radius: max(0px, root.bottom-radius - 1px);
            border-bottom-right-radius: max(0px, root.bottom-radius - 1px);
        }
    }
    if !root.open && root.tinted : Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        background: root.tint;
        border-radius: max(0px, Theme.radius - 1px);
    }
    @children
}

// End task as a small ×, at the end of a card's name area (the context menu and Delete do the
// same). Red under the pointer.
component EndTaskButton inherits FocusButton {
    width: 22px;
    height: 22px;
    border-radius: 4px;
    background: root.hovered ? Theme.danger : transparent;
    border-width: root.focus-visible ? 2px : 0px;
    border-color: Theme.text;
    Path {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 1 1 L 9 9 M 9 1 L 1 9";
        stroke: root.hovered ? Theme.on-danger : Theme.muted;
        stroke-width: 1.5px;
        fill: transparent;
    }
}

// A column header: sorts the list by its column (again: flips the direction). The sorted one is
// in the accent colour with ▾ (descending) or ▴ (ascending), drawn.
export component SortHeader inherits FocusButton {
    in property <string> label;
    in property <bool> sorted;
    in property <bool> descending;
    in property <bool> left;
    border-radius: 4px;
    border-width: root.focus-visible ? 2px : 0px;
    border-color: Theme.text;
    // "Sort by <column>" first (what activating it does), then which way the sorted one runs.
    accessible-label: "Sort by " + root.label + (root.sorted ? (root.descending ? ", sorted descending" : ", sorted ascending") : "");
    accessible-checkable: true;
    accessible-checked: root.sorted;
    HorizontalLayout {
        alignment: root.left ? LayoutAlignment.start : LayoutAlignment.end;
        padding-left: 2px;
        padding-right: 2px;
        spacing: 4px;
        Text {
            text: root.label.to-uppercase();
            font-size: 11.5px;
            letter-spacing: 0.5px;
            vertical-alignment: center;
            color: root.sorted ? Theme.accent : (root.hovered ? Theme.text : Theme.muted);
        }
        if root.sorted : Rectangle {
            width: 8px;
            Path {
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 5px;
                viewbox-width: 8;
                viewbox-height: 5;
                commands: root.descending ? "M 0 0 L 8 0 L 4 5 Z" : "M 0 5 L 8 5 L 4 0 Z";
                fill: Theme.accent;
            }
        }
    }
}

component StaticHeader inherits Rectangle {
    in property <string> label;
    in property <bool> right-align: false;
    Text {
        x: 2px;
        y: (root.height - self.height) / 2;
        width: root.width - 4px;
        height: self.preferred-height;
        text: root.label.to-uppercase();
        horizontal-alignment: root.right-align ? right : left;
        font-size: 11.5px;
        letter-spacing: 0.5px;
        color: Theme.muted;
    }
}

// The one row menu, shared by each row (right-click, Menu key on a focused row control) and by the
// list's current row (Menu key on the list). Never opens by itself: the owner captures the target
// row first, then calls open(); every item reports only its action name, and the owner applies it
// to that captured row.
component RowMenu inherits Rectangle {
    in property <bool> actionable;
    callback action(string);
    public function open(x: length, y: length) {
        area.show({ x: x, y: y });
    }
    area := ContextMenuArea {
        // Disabled so Slint never opens it by itself (right press, Menu key, Shift+F10) without
        // the owner's capture; show() still works (see the UI tests).
        enabled: false;
        Menu {
            MenuItem { title: "End task"; enabled: root.actionable; activated => { root.action("end-task"); } }
            MenuItem { title: "End process tree"; enabled: root.actionable; activated => { root.action("end-tree"); } }
            MenuItem { title: "Efficiency mode"; enabled: root.actionable; activated => { root.action("efficiency"); } }
            MenuSeparator { }
            MenuItem { title: "Set CPU affinity..."; enabled: root.actionable; activated => { root.action("set-affinity"); } }
            MenuItem { title: "Set CPU priority..."; enabled: root.actionable; activated => { root.action("set-priority"); } }
            MenuSeparator { }
            MenuItem { title: "Exclude from Aequilibrium"; enabled: root.actionable; activated => { root.action("toggle-aequilibrium-exclusion"); } }
            MenuSeparator { }
            MenuItem { title: "Open file location"; enabled: root.actionable; activated => { root.action("open-location"); } }
            MenuItem { title: "Details"; enabled: root.actionable; activated => { root.action("details"); } }
        }
    }
    // Beside the area, not inside it (it never handles input itself, so it needs no content;
    // Slint 1.18's compiler panics inlining @children into a ContextMenuArea). Both fill the
    // component, so open() coordinates are the content's own.
    @children
}

export component AppList inherits VerticalLayout {
    in property <[RowData]> rows;
    in property <int> metric;
    in property <bool> interactive: true;
    in-out property <string> search-text;
    // The list's sort (crate::controls): -1 the name column, 0..4 a metric's index.
    in property <int> sort-column;
    in property <bool> sort-descending;
    // Optional columns.
    in property <bool> col-pid;
    in property <bool> col-proc-name;
    in property <bool> col-status;
    in property <bool> col-threads;
    in property <bool> col-handles;
    in property <bool> col-publisher;
    callback toggle-column(int);
    callback open-run-task();
    // Keyboard navigation (ruling P3-7): the current row's index and id, and whether it can be acted on.
    in property <int> current-row: -1;
    // The current row's top within the list and its height (rows differ in height).
    in property <length> current-row-y;
    in property <length> current-row-h;
    in property <int> current-id: -1;
    in property <bool> current-actionable;
    out property <bool> hovered: area.has-hover;
    out property <length> scroll-y: lv.content-y;
    // Row heights by kind, mirrored from crate::view::ROW_H_* (a test keeps them equal): Rust sums
    // them for scrolling to a row and for the keyboard menu's anchor.
    private property <length> section-height: 32px;
    private property <length> app-height: 50px;
    private property <length> proc-height: 30px;
    // An app card itself; the rest of its row is the gap below it.
    private property <length> card-height: 46px;
    // The list's scrollbar gutter (as on the Performance, Startup, and Settings pages).
    property <length> gutter: 14px;
    // The row a context menu was opened on. Captured when it opens; every menu item acts on it,
    // never on whatever row data sits at that index by the time an item is chosen.
    out property <int> menu-target: -1;
    callback toggle(int);
    callback action(string, int);
    callback hover(bool);
    // A column header was clicked: -1 Name, 0..4 a metric.
    callback sort-clicked(int);
    // True when a row's context menu opens, false once it has closed: the list stays frozen meanwhile.
    callback menu-open(bool);
    // Keyboard focus entered (true) or left (false) a control inside row `id`: the list stays
    // frozen meanwhile, like on hover, so the focused control can't move to another app.
    callback row-focus(int, bool);
    callback search(string);
    // The list itself gained (true) or lost (false) keyboard focus: frozen meanwhile, like on hover.
    callback list-focus(bool);
    // A key while the list itself has focus; true when it was a navigation key.
    callback list-key(string) -> bool;
    // Esc in the list: the owner parks keyboard focus (never none at all, so the menu key still
    // reaches the owner and can bring the list back).
    callback park-focus();
    spacing: 6px;

    // Scrolls so the row at `y` (its top in the list), `h` tall, is fully visible.
    public function ensure-visible(y: length, h: length) {
        if (y < -lv.content-y) {
            lv.content-y = -y;
        } else if (y + h > -lv.content-y + lv.visible-height) {
            lv.content-y = -(y + h - lv.visible-height);
        }
    }

    // Gives the list keyboard focus: the ring shows on the current row (or the first), and the
    // list freezes, exactly as when Tab reaches it.
    public function focus-list() {
        list-keys.focus();
    }

    public function focus-search() {
        search-box.focus();
    }

    // The current row's menu from the keyboard (Menu key, Shift+F10) while the list has focus.
    // Same capture rule as a row's own menu: the target is fixed before the menu shows.
    function open-key-menu() {
        if (root.current-id >= 0 && root.current-actionable && root.interactive) {
            root.menu-target = root.current-id;
            root.menu-open(true);
            // A wheel may have scrolled the current row away: bring it back so the menu anchors on it.
            root.ensure-visible(root.current-row-y, root.current-row-h);
            key-menu.open(24px, root.current-row-y + root.current-row-h + lv.content-y);
            root.menu-open(false);
        }
    }

    HorizontalLayout {
        spacing: 8px;
        search-box := LineEdit {
            horizontal-stretch: 1;
            text <=> root.search-text;
            placeholder-text: "Type a name, publisher, or PID to search";
            accessible-label: "Search apps and processes";
            enabled: root.interactive;
            edited(text) => { root.search(text); }
        }
        Rectangle {
            width: 82px;
            height: 32px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.card-border;
            background: col-ta.has-hover ? Theme.card-hover : Theme.card;
            accessible-role: button;
            accessible-label: "Columns";
            accessible-action-default => {
                if root.interactive {
                    cols-menu.show({ x: 0px, y: self.height });
                }
            }
            cols-menu := ContextMenuArea {
                enabled: false;
                Menu {
                    MenuItem { title: (root.col-pid ? "✓ " : "    ") + "PID"; activated => { root.toggle-column(0); } }
                    MenuItem { title: (root.col-proc-name ? "✓ " : "    ") + "Process name"; activated => { root.toggle-column(1); } }
                    MenuItem { title: (root.col-status ? "✓ " : "    ") + "Status"; activated => { root.toggle-column(2); } }
                    MenuItem { title: (root.col-threads ? "✓ " : "    ") + "Threads"; activated => { root.toggle-column(3); } }
                    MenuItem { title: (root.col-handles ? "✓ " : "    ") + "Handles"; activated => { root.toggle-column(4); } }
                    MenuItem { title: (root.col-publisher ? "✓ " : "    ") + "Publisher"; activated => { root.toggle-column(5); } }
                }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: "Columns";
                    font-size: 12px;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Path {
                    width: 8px;
                    height: 5px;
                    y: (parent.height - self.height) / 2;
                    viewbox-width: 8;
                    viewbox-height: 5;
                    commands: "M 0 1 L 4 5 L 8 1";
                    stroke: Theme.muted;
                    stroke-width: 1.5px;
                    fill: transparent;
                }
            }
            col-ta := TouchArea {
                enabled: root.interactive;
                mouse-cursor: pointer;
                clicked => { cols-menu.show({ x: 0px, y: parent.height }); }
            }
        }
        Rectangle {
            width: 106px;
            height: 32px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.card-border;
            background: run-ta.has-hover ? Theme.card-hover : Theme.card;
            accessible-role: button;
            accessible-label: "Run new task";
            accessible-action-default => {
                if root.interactive {
                    root.open-run-task();
                }
            }
            Text {
                text: "+ Run new task";
                font-size: 12px;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            run-ta := TouchArea {
                enabled: root.interactive;
                mouse-cursor: pointer;
                clicked => { root.open-run-task(); }
            }
        }
    }
    HorizontalLayout {
        padding-left: Columns.left;
        padding-right: Columns.right + root.gutter;
        spacing: Columns.gap;
        height: 24px;
        SortHeader {
            label: "Name";
            left: true;
            horizontal-stretch: 1;
            sorted: root.sort-column == -1;
            descending: root.sort-descending;
            interactive: root.interactive;
            activated => { root.sort-clicked(-1); }
        }
        if root.col-pid : StaticHeader { label: "PID"; width: 62px; right-align: true; }
        if root.col-proc-name : StaticHeader { label: "Process"; width: 110px; }
        if root.col-status : StaticHeader { label: "Status"; width: 96px; }
        if root.col-publisher : StaticHeader { label: "Publisher"; width: 130px; }
        if root.col-threads : StaticHeader { label: "Threads"; width: 64px; right-align: true; }
        if root.col-handles : StaticHeader { label: "Handles"; width: 68px; right-align: true; }
        for label[c] in ["CPU", "Memory", "Disk", "GPU", "Network"] : SortHeader {
            label: label;
            width: Columns.number;
            sorted: root.sort-column == c;
            descending: root.sort-descending;
            interactive: root.interactive;
            activated => { root.sort-clicked(c); }
        }
    }
    list-keys := FocusScope {
        vertical-stretch: 1;
        enabled: root.interactive;
        // Mouse clicks never select rows or move focus here; only Tab does (ruling P3-7).
        focus-on-click: false;
        accessible-role: list;
        accessible-label: "Apps";
        changed has-focus => { root.list-focus(self.has-focus); }
        key-pressed(e) => {
            // Keys bubbling up from a focused row control are not list navigation.
            if (!self.has-focus) {
                return reject;
            }
            if (e.text == Key.Escape) {
                root.park-focus();
                return accept;
            }
            if (e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift)) {
                root.open-key-menu();
                return accept;
            }
            return root.list-key(e.text) ? accept : reject;
        }
        key-menu := RowMenu {
            actionable: root.current-actionable;
            action(name) => { root.action(name, root.menu-target); }
            area := TouchArea {
                enabled: root.interactive;
                changed has-hover => { root.hover(self.has-hover); }
                // Not a ListView: its virtual layout places rows by their average height, so with
                // headings, cards and process rows mixed a row was drawn away from the top Rust sums
                // (crate::bridge::row_top) and keyboard scrolling missed it. Here every row is an empty
                // slot at its exact height in one column; only the slots in view build their row.
                lv := ScrollView {
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    content-width: max(0px, self.visible-width - root.gutter);
                    content-height: column.preferred-height;
                    // Rows that went (a collapse, a search) never leave the view scrolled past the end.
                    changed content-height => {
                        self.content-y = max(self.content-y, min(0px, self.visible-height - self.content-height));
                    }
                    column := VerticalLayout {
                        width: lv.content-width;
                        height: self.preferred-height;
                        for r[i] in root.rows : slot := Rectangle {
                            // Set while this card's End task holds focus (it outlives the hover then).
                            property <bool> end-focused;
                            // Set while a control in this row (End task, Force close) holds focus.
                            property <bool> control-focused;
                            // In view: the row is built.
                            property <bool> built: self.y + self.height > -lv.content-y && self.y < -lv.content-y + lv.visible-height;
                            // Scrolled away, the row and its focused control are destroyed without a
                            // focus-out: report one, or the list would stay frozen on a control that is gone.
                            changed built => {
                                if (!self.built && self.control-focused) {
                                    self.control-focused = false;
                                    self.end-focused = false;
                                    root.row-focus(r.id, false);
                                }
                            }
                            height: r.kind == 0 ? root.section-height : (r.kind == 1 ? root.app-height : root.proc-height);
                            if slot.built : row := Rectangle {
                                // The keyboard-current row, while the list has focus.
                                property <bool> current: i == root.current-row && list-keys.has-focus;
                                property <bool> hovered: row-touch.has-hover;
                                // An app card whose process strip goes on below it.
                                property <bool> open-below: r.kind == 1 && i + 1 < root.rows.length && root.rows[i + 1].kind == 2;
                                // The first process row of a card: a hairline parts it from the card's head.
                                property <bool> first-in-card: r.kind == 2 && i > 0 && root.rows[i - 1].kind != 2;
                                // How much of the row the card (or strip) covers; the rest is the gap below it.
                                property <length> body: r.kind == 1 ? (self.open-below ? self.height : root.card-height)
                                    : r.kind == 2 && r.last-in-card ? self.height - (root.app-height - root.card-height) : self.height;
                                property <brush> fill: r.hung != "" ? Theme.danger-bg : (self.hovered ? Theme.card-hover : Theme.card);
                                opacity: r.exited ? 0.5 : 1.0;
                                accessible-role: list-item;
                                accessible-item-selectable: true;
                                // Selected like the ring: the current row, while the list has focus.
                                accessible-item-selected: self.current;
                                accessible-label: r.kind == 0 ? r.name + (r.count != "" ? " " + r.count : "") + " section, " + (r.expanded ? "expanded" : "collapsed")
                                    : r.exited ? r.name + ", exited"
                                    : r.name + (r.hung != "" ? ", " + r.hung : "") + ", CPU " + r.cpu + ", memory " + r.mem;
                                // A heading opens and closes its section (Enter does too, through the list).
                                accessible-action-default => {
                                    if (r.kind == 0 && root.interactive) {
                                        root.toggle(r.id);
                                    }
                                }
                                // The only way this row's menu opens: capture the row first, keep the list frozen
                                // while it is open. The native Windows menu (muda, TrackPopupMenu) is modal: show()
                                // returns only once it has closed. Slint's popup fallback (no native menus) returns at
                                // once; there the captured menu-target alone keeps the action on the right row.
                                function open-menu(x: length, y: length) {
                                    if (r.actionable && root.interactive) {
                                        root.menu-target = r.id;
                                        root.menu-open(true);
                                        menu.open(x, y);
                                        root.menu-open(false);
                                    }
                                }
                                // Expanding needs a live app: an exited one has nothing left to show.
                                function toggle-card() {
                                    if (r.expandable && !r.exited) {
                                        root.toggle(r.id);
                                    }
                                }
                                menu := RowMenu {
                                    actionable: r.actionable;
                                    action(name) => { root.action(name, root.menu-target); }
                                    // Never takes focus itself; key presses a focused control in this row rejects
                                    // (the buttons take only Space and Return) bubble up here.
                                    row-keys := FocusScope {
                                        enabled: false;
                                        // Any key pressed while focus is inside this row (re)asserts the freeze, so a
                                        // missed focus edge can't leave Space acting on an unfrozen list.
                                        capture-key-pressed(e) => {
                                            root.row-focus(r.id, true);
                                            return reject;
                                        }
                                        key-pressed(e) => {
                                            if (e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift)) {
                                                open-menu(8px, row.body);
                                                return accept;
                                            }
                                            return reject;
                                        }
                                        row-touch := TouchArea {
                                            enabled: root.interactive;
                                            clicked => {
                                                if (r.kind == 0) {
                                                    root.toggle(r.id);
                                                }
                                            }
                                            double-clicked => {
                                                if (r.kind != 0) {
                                                    toggle-card();
                                                }
                                            }
                                            pointer-event(e) => {
                                                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                                    open-menu(self.mouse-x, self.mouse-y);
                                                }
                                            }
                                            // A section heading: chevron, name and count.
                                            if r.kind == 0 : HorizontalLayout {
                                                padding-left: Columns.left;
                                                padding-right: Columns.right;
                                                spacing: Columns.gap;
                                                Chevron { open: r.expanded; }
                                                HorizontalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: start;
                                                    spacing: 6px;
                                                    Text { text: r.name; color: Theme.muted; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                                    Text { text: r.count; color: Theme.muted; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                                }
                                            }
                                            // An app's card; open at the bottom while its processes show below it.
                                            if r.kind == 1 : CardSlice {
                                                y: 0;
                                                height: row.body;
                                                open-bottom: row.open-below;
                                                fill: row.fill;
                                                edge: row.hovered ? Theme.muted.with-alpha(0.3) : Theme.card-border;
                                                HorizontalLayout {
                                                    y: 0;
                                                    height: root.card-height;
                                                    padding-left: Columns.left;
                                                    padding-right: Columns.right;
                                                    spacing: Columns.gap;
                                                    if r.expandable : Chevron {
                                                        open: r.expanded;
                                                        accessible-role: button;
                                                        accessible-label: (r.expanded ? "Collapse " : "Expand ") + r.name;
                                                        accessible-action-default => { toggle-card(); }
                                                        TouchArea {
                                                            enabled: root.interactive;
                                                            clicked => { toggle-card(); }
                                                        }
                                                    }
                                                    if !r.expandable : Rectangle { width: 14px; }
                                                    RowIcon {
                                                        size: 24px;
                                                        source: r.icon;
                                                        has-icon: r.has-icon;
                                                        windows: r.windows;
                                                    }
                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        alignment: center;
                                                        spacing: 1px;
                                                        HorizontalLayout {
                                                            spacing: 6px;
                                                            alignment: start;
                                                            Text { text: r.name; color: Theme.text; font-size: 13.5px; overflow: elide; }
                                                            if r.restrained : Image {
                                                                source: @image-url("../assets/aequilibrium.svg");
                                                                width: 14px;
                                                                height: 14px;
                                                                vertical-alignment: center;
                                                                accessible-label: "Restrained by Aequilibrium";
                                                            }
                                                        }
                                                        Text {
                                                            text: r.exited ? "Exited" : r.sub;
                                                            color: r.hung != "" ? Theme.danger-text : Theme.muted;
                                                            font-size: 11.5px;
                                                            overflow: elide;
                                                        }
                                                    }
                                                    if r.hung != "" && r.actionable : Button {
                                                        text: "Force close";
                                                        enabled: root.interactive;
                                                        accessible-label: "Force close " + r.name;
                                                        changed has-focus => {
                                                            slot.control-focused = self.has-focus;
                                                            root.row-focus(r.id, self.has-focus);
                                                        }
                                                        clicked => { root.action("force-close", r.id); }
                                                    }
                                                    // While the card is hovered or keyboard-current, and for as long as the
                                                    // button holds focus (the list stays frozen meanwhile, so it stays this app's).
                                                    if r.hung == "" && r.actionable && r.depth == 0 && (row.hovered || row.current || slot.end-focused) : Rectangle {
                                                        width: 22px;
                                                        EndTaskButton {
                                                            y: (parent.height - self.height) / 2;
                                                            interactive: root.interactive;
                                                            accessible-label: "End task " + r.name;
                                                            changed focused => {
                                                                slot.end-focused = self.focused;
                                                                slot.control-focused = self.focused;
                                                                root.row-focus(r.id, self.focused);
                                                            }
                                                            activated => { root.action("end-task", r.id); }
                                                        }
                                                    }
                                                    if root.col-pid : OptTextCell { text: r.col-pid; width: 62px; right-align: true; }
                                                    if root.col-proc-name : OptTextCell { text: r.col-proc-name; width: 110px; }
                                                    if root.col-status : OptTextCell { text: r.col-status; width: 96px; }
                                                    if root.col-publisher : OptTextCell { text: r.col-publisher; width: 130px; }
                                                    if root.col-threads : OptTextCell { text: r.col-threads; width: 64px; right-align: true; }
                                                    if root.col-handles : OptTextCell { text: r.col-handles; width: 68px; right-align: true; }
                                                    NumCell { text: r.cpu; strong: root.metric == 0; size: 13px; bar: r.bars[0]; }
                                                    NumCell { text: r.mem; strong: root.metric == 1; size: 13px; bar: r.bars[1]; }
                                                    NumCell { text: r.disk; strong: root.metric == 2; size: 13px; bar: r.bars[2]; }
                                                    NumCell { text: r.gpu; strong: root.metric == 3; size: 13px; bar: r.bars[3]; }
                                                    NumCell { text: r.net; strong: root.metric == 4; size: 13px; bar: r.bars[4]; }
                                                }
                                            }
                                            // A process row inside its card, on the card's darker strip; the last closes it.
                                            if r.kind == 2 : CardSlice {
                                                y: 0;
                                                height: row.body;
                                                open-top: true;
                                                open-bottom: !r.last-in-card;
                                                fill: row.fill;
                                                edge: Theme.card-border;
                                                tint: Theme.card-inset;
                                                tinted: r.hung == "";
                                                if row.first-in-card : Rectangle {
                                                    x: 1px;
                                                    y: 0;
                                                    width: parent.width - 2px;
                                                    height: 1px;
                                                    background: Theme.card-border;
                                                }
                                                HorizontalLayout {
                                                    // Its icon centred under the card's.
                                                    padding-left: Columns.left + 14px + Columns.gap + 4px;
                                                    padding-right: Columns.right;
                                                    spacing: Columns.gap;
                                                    RowIcon {
                                                        size: 16px;
                                                        source: r.icon;
                                                        has-icon: r.has-icon;
                                                        windows: r.windows;
                                                    }
                                                    HorizontalLayout {
                                                        horizontal-stretch: 1;
                                                        alignment: start;
                                                        spacing: 6px;
                                                        Text { text: r.name; color: Theme.text; font-size: 12.5px; vertical-alignment: center; overflow: elide; }
                                                        if r.restrained : Image {
                                                            source: @image-url("../assets/aequilibrium.svg");
                                                            width: 13px;
                                                            height: 13px;
                                                            vertical-alignment: center;
                                                            accessible-label: "Restrained by Aequilibrium";
                                                        }
                                                        Text { text: r.pid; color: Theme.muted; font-size: 12.5px; vertical-alignment: center; }
                                                        if r.exited : Text { text: "Exited"; color: Theme.muted; font-size: 11.5px; vertical-alignment: center; }
                                                        if r.hung != "" : Text { text: r.hung; color: Theme.danger-text; font-size: 11.5px; vertical-alignment: center; }
                                                    }
                                                    if r.hung != "" && r.actionable : Button {
                                                        // Inside the strip's 30 px.
                                                        height: 24px;
                                                        text: "Force close";
                                                        enabled: root.interactive;
                                                        accessible-label: "Force close " + r.name;
                                                        changed has-focus => {
                                                            slot.control-focused = self.has-focus;
                                                            root.row-focus(r.id, self.has-focus);
                                                        }
                                                        clicked => { root.action("force-close", r.id); }
                                                    }
                                                    if root.col-pid : OptTextCell { text: r.col-pid; width: 62px; size: 12px; right-align: true; }
                                                    if root.col-proc-name : OptTextCell { text: r.col-proc-name; width: 110px; size: 12px; }
                                                    if root.col-status : OptTextCell { text: r.col-status; width: 96px; size: 12px; }
                                                    if root.col-publisher : OptTextCell { text: r.col-publisher; width: 130px; size: 12px; }
                                                    if root.col-threads : OptTextCell { text: r.col-threads; width: 64px; size: 12px; right-align: true; }
                                                    if root.col-handles : OptTextCell { text: r.col-handles; width: 68px; size: 12px; right-align: true; }
                                                    NumCell { text: r.cpu; strong: root.metric == 0; size: 12.5px; }
                                                    NumCell { text: r.mem; strong: root.metric == 1; size: 12.5px; }
                                                    NumCell { text: r.disk; strong: root.metric == 2; size: 12.5px; }
                                                    NumCell { text: r.gpu; strong: root.metric == 3; size: 12.5px; }
                                                    NumCell { text: r.net; strong: root.metric == 4; size: 12.5px; }
                                                }
                                            }
                                            // The keyboard-current row's ring, over the card or heading (not the gap).
                                            if row.current : Rectangle {
                                                y: 0;
                                                height: row.body;
                                                border-width: 2px;
                                                border-color: Theme.text;
                                                border-radius: r.kind == 1 ? Theme.radius : 4px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // In place of the Fluent scrollbar (ScrollIndicator says why).
                if lv.content-height > lv.visible-height : ScrollIndicator {
                    x: lv.width - self.width;
                    height: lv.height;
                    interactive: root.interactive;
                    content-y <=> lv.content-y;
                    visible-height: lv.visible-height;
                    content-height: lv.content-height;
                }
            }
        }
    }
}
