import { Theme } from "theme.slint";

export struct GraphData { label: string, value: string, scale: string, line: string, area: string, line2: string }
export struct ScrubRow { name: string, value: string }

// The clock every time graph scrolls by (crate::smooth). Rust sets `smooth` (Settings > Smooth
// graphs) and `shown` (the window is neither hidden to the tray nor minimised);
// MainWindow.scroll-from starts a run when a frame lands, and MainWindow's timer advances `now`,
// both from `clock()`.
export global GraphClock {
    in property <bool> smooth: true;
    in property <bool> shown: true;
    out property <bool> live: smooth && shown;
    // The run (crate::smooth::Scroll): where the view's right edge started relative to the newest
    // sample (ms, <= 0), how many ms of graph time pass per ms, and when it started. Speed 0 rests
    // the view on the newest sample (MainWindow.scroll-from(0, 0)).
    in-out property <float> lead-ms;
    in-out property <float> speed: 1;
    in-out property <duration> anchor;
    in-out property <duration> now;
    // The view's right edge relative to the newest sample, ms (<= 0): it never passes the newest
    // sample, and rests on it while graphs don't scroll.
    out property <float> offset-ms: live ? min(0, lead-ms + speed * ((now - anchor) / 1ms)) : 0;
    // The time graphs scroll by, from the clock Rust supplies (crate::smooth::install: the
    // collector's epoch, so the bridge's view edge and this one agree). Not `animation-tick()`:
    // reading that marks an animation as running, and the backend then draws a second, identical
    // frame for every timer tick.
    callback clock() -> duration;
    // Redraws a second for a graph this many physical pixels wide over this many ms, at the
    // nominal speed of 1 (crate::smooth::redraw_hz; Rust implements it, crate::smooth::install).
    pure callback redraw-hz(width-px: float, span-ms: float) -> float;
    // A run cut short (smoothing turned off, the window hidden or minimised) rests on the newest
    // sample, so the view stays there if graphs scroll again before the next frame lands (PF3).
    changed live => {
        if (!self.live) {
            self.lead-ms = 0;
            self.speed = 0;
        }
    }
}

// A data path: crate::graph's 1000 × 100 view box stretched over the element. It clips to its box
// horizontally only: history left of the window is drawn at negative x (crate::graph::LEAD_MS) and
// must stay out of sight, but a stroke centred on y = 0 or y = 100 (an idle 0% line) keeps its
// full width, so the clip rectangle reaches past the box and the Path sits inside it.
//
// Every data path scrolls with GraphClock: the paths put the newest sample at x = 1000 and the
// view's left edge sits `GraphClock.offset-ms` of graph time before that, in path units.
export component DataPath inherits Rectangle {
    in property <string> commands;
    // The time the path's 1000 units cover (crate::perf::Range; sparklines 60 s, crate::view::SPARK_SECONDS).
    in property <float> span-ms: 60000;
    in property <brush> paint: transparent;
    in property <brush> stroke: transparent;
    in property <length> stroke-width: 1.5px;
    Rectangle {
        x: 0;
        y: -2px;
        width: parent.width;
        height: parent.height + 4px;
        clip: true;
        Path {
            x: 0;
            y: 2px;
            width: parent.width;
            height: parent.height - 4px;
            viewbox-x: GraphClock.offset-ms * 1000 / max(1, root.span-ms);
            viewbox-width: 1000;
            viewbox-height: 100;
            fit: fill;
            commands: root.commands;
            fill: root.paint;
            stroke: root.stroke;
            stroke-width: root.stroke-width;
        }
    }
}

// A time graph: grid, translucent area, line and an optional second line (write / send). The
// paths come from crate::graph for a 1000 × 100 view box, newest sample on the right edge.
export component Graph inherits Rectangle {
    in property <GraphData> data;
    // Draw the translucent area under the line. The small multiples turn it off: the software
    // renderer rasterises every Path on every frame, at a cost that grows with the area covered,
    // and dozens of filled cells made resizing the Performance page slow.
    in property <bool> filled: true;
    // The time the paths cover (crate::perf::Range), for the scrolling offset.
    in property <float> span-ms: 60000;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card;
    clip: true;
    accessible-role: image;
    accessible-label: root.data.label + " graph";
    for i in 3 : Rectangle {
        x: 0;
        y: root.height * (i + 1) / 4;
        width: root.width;
        height: 1px;
        background: Theme.card-border;
    }
    // Inset vertically: the card's own clip would trim a stroke on the 0% or 100% line in half.
    DataPath {
        x: 0;
        y: 2px;
        width: root.width;
        height: root.height - 4px;
        span-ms: root.span-ms;
        visible: root.filled;
        commands: root.data.area;
        paint: Theme.accent.with-alpha(0.16);
    }
    DataPath {
        x: 0;
        y: 2px;
        width: root.width;
        height: root.height - 4px;
        span-ms: root.span-ms;
        commands: root.data.line;
        stroke: Theme.accent;
        stroke-width: 1.5px;
    }
    DataPath {
        x: 0;
        y: 2px;
        width: root.width;
        height: root.height - 4px;
        span-ms: root.span-ms;
        commands: root.data.line2;
        stroke: Theme.muted;
        stroke-width: 1.5px;
    }

    // History scrub (only the large graphs take part).
    in property <bool> scrubbable: false;
    // Fraction across the graph of the scrub cursor, -1 when none.
    in property <float> scrub-x: -1;
    in property <string> scrub-title;
    in property <string> scrub-empty;
    // A footnote under the rows (network pages: "All adapters"), or empty.
    in property <string> scrub-note;
    in property <[ScrubRow]> scrub-rows;
    callback scrub(float);

    ta := TouchArea {
        enabled: root.scrubbable;
        // mouse-x follows the pointer while it hovers, so every move over the graph reports.
        changed mouse-x => {
            if (self.has-hover) {
                root.scrub(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
        changed has-hover => {
            root.scrub(self.has-hover ? clamp(self.mouse-x / self.width, 0, 1) : -1);
        }
    }
    if root.scrub-x >= 0 : Rectangle {
        x: root.width * root.scrub-x;
        y: 0;
        width: 1px;
        height: root.height;
        background: Theme.text;
    }
    // The card stays inside the graph, which clips: it sits right of the cursor, or left of it
    // when it would pass the right edge, and lists only as many apps as the graph's height holds.
    // Network values carry the upload/download split: a wider card.
    property <length> card-w: min(root.scrub-note == "" ? 210px : 280px, root.width - 16px);
    property <length> note-h: root.scrub-note == "" ? 0px : 16px;
    property <length> cursor-px: root.width * root.scrub-x;
    property <int> card-rows: max(0, min(root.scrub-rows.length, floor((root.height - 16px - 34px - root.note-h) / 16px)));
    if root.scrub-x >= 0 && ta.has-hover : Rectangle {
        accessible-role: groupbox;
        accessible-label: root.scrub-title;
        width: root.card-w;
        // Padding 8 + title 18 + rows of 16 (or two lines of the empty text) + the note + padding 8.
        property <length> body-h: root.scrub-rows.length == 0 ? 32px : root.card-rows * 16px;
        height: 34px + self.body-h + root.note-h;
        x: max(0px, min(root.width - self.width,
            root.cursor-px + 8px + self.width > root.width ? root.cursor-px - self.width - 8px : root.cursor-px + 8px));
        y: 8px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.card-border;
        background: Theme.palette-dark ? #2b2b2b : #ffffff;
        Text {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: 18px;
            text: root.scrub-title;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }
        for r[i] in root.scrub-rows : Rectangle {
            x: 8px;
            y: 26px + i * 16px;
            width: parent.width - 16px;
            height: 16px;
            visible: i < root.card-rows;
            value := Text {
                x: parent.width - self.width;
                height: parent.height;
                text: r.value;
                color: Theme.text;
                font-size: 11px;
                vertical-alignment: center;
            }
            Text {
                x: 0;
                width: max(0px, parent.width - value.width - 8px);
                height: parent.height;
                text: r.name;
                color: Theme.text;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        if root.scrub-rows.length == 0 : Text {
            x: 8px;
            y: 26px;
            width: parent.width - 16px;
            height: 32px;
            text: root.scrub-empty;
            color: Theme.muted;
            font-size: 11px;
            wrap: word-wrap;
        }
        if root.scrub-note != "" : Text {
            x: 8px;
            y: 26px + parent.body-h;
            width: parent.width - 16px;
            height: root.note-h;
            text: root.scrub-note;
            color: Theme.muted;
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}
