import { Theme } from "theme.slint";

export struct GraphData { label: string, value: string, scale: string, line: string, area: string, line2: string }
export struct ScrubRow { name: string, value: string }

// A time graph: grid, translucent area, line and an optional second line (write / send). The
// paths come from crate::graph for a 1000 × 100 view box, newest sample on the right edge.
export component Graph inherits Rectangle {
    in property <GraphData> data;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card;
    clip: true;
    accessible-role: image;
    accessible-label: root.data.label + " graph";
    for i in 3 : Rectangle {
        x: 0;
        y: root.height * (i + 1) / 4;
        width: root.width;
        height: 1px;
        background: Theme.card-border;
    }
    Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: 1000;
        viewbox-height: 100;
        commands: root.data.area;
        fill: Theme.accent.with-alpha(0.16);
        stroke: transparent;
    }
    Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: 1000;
        viewbox-height: 100;
        commands: root.data.line;
        fill: transparent;
        stroke: Theme.accent;
        stroke-width: 1.5px;
    }
    Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: 1000;
        viewbox-height: 100;
        commands: root.data.line2;
        fill: transparent;
        stroke: Theme.muted;
        stroke-width: 1.5px;
    }

    // History scrub (only the large graphs take part).
    in property <bool> scrubbable: false;
    // Fraction across the graph of the scrub cursor, -1 when none.
    in property <float> scrub-x: -1;
    in property <string> scrub-title;
    in property <string> scrub-empty;
    in property <[ScrubRow]> scrub-rows;
    callback scrub(float);

    ta := TouchArea {
        enabled: root.scrubbable;
        // mouse-x follows the pointer while it hovers, so every move over the graph reports.
        changed mouse-x => {
            if (self.has-hover) {
                root.scrub(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
        changed has-hover => {
            root.scrub(self.has-hover ? clamp(self.mouse-x / self.width, 0, 1) : -1);
        }
    }
    if root.scrub-x >= 0 : Rectangle {
        x: root.width * root.scrub-x;
        y: 0;
        width: 1px;
        height: root.height;
        background: Theme.text;
    }
    // The card stays inside the graph, which clips: it sits right of the cursor, or left of it
    // when it would pass the right edge, and lists only as many apps as the graph's height holds.
    property <length> card-w: min(210px, root.width - 16px);
    property <length> cursor-px: root.width * root.scrub-x;
    property <int> card-rows: max(0, min(root.scrub-rows.length, floor((root.height - 16px - 34px) / 16px)));
    if root.scrub-x >= 0 && ta.has-hover : Rectangle {
        accessible-role: groupbox;
        accessible-label: root.scrub-title;
        width: root.card-w;
        // Padding 8 + title 18 + rows of 16 (or two lines of the empty text) + padding 8.
        height: 34px + (root.scrub-rows.length == 0 ? 32px : root.card-rows * 16px);
        x: max(0px, min(root.width - self.width,
            root.cursor-px + 8px + self.width > root.width ? root.cursor-px - self.width - 8px : root.cursor-px + 8px));
        y: 8px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.card-border;
        background: Theme.dark ? #2b2b2b : #ffffff;
        Text {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: 18px;
            text: root.scrub-title;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }
        for r[i] in root.scrub-rows : Rectangle {
            x: 8px;
            y: 26px + i * 16px;
            width: parent.width - 16px;
            height: 16px;
            visible: i < root.card-rows;
            value := Text {
                x: parent.width - self.width;
                height: parent.height;
                text: r.value;
                color: Theme.text;
                font-size: 11px;
                vertical-alignment: center;
            }
            Text {
                x: 0;
                width: max(0px, parent.width - value.width - 8px);
                height: parent.height;
                text: r.name;
                color: Theme.text;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        if root.scrub-rows.length == 0 : Text {
            x: 8px;
            y: 26px;
            width: parent.width - 16px;
            height: 32px;
            text: root.scrub-empty;
            color: Theme.muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}
