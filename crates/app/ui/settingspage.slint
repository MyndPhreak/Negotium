import { Theme } from "theme.slint";
import { FocusButton } from "focusbutton.slint";
import { RevealScrollView } from "revealscroll.slint";
import { LineEdit, Slider } from "std-widgets.slint";

// An on/off switch. `checked` is owned by the caller: the switch only asks (`toggled` with the
// requested state), so a refused change never leaves it showing the wrong state.
export component Toggle inherits FocusButton {
    in property <string> label;
    // Read out after the label (the row's description).
    in property <string> description;
    in property <bool> checked;
    callback toggled(bool);
    width: 40px;
    height: 20px;
    vertical-stretch: 0;
    border-radius: 10px;
    // Disabled (a later version, or under a modal): dimmed as a whole.
    opacity: root.interactive ? 1 : 0.5;
    background: root.checked && root.interactive ? Theme.accent : transparent;
    border-width: root.focus-visible ? 2px : (root.checked && root.interactive ? 0px : 1px);
    border-color: root.focus-visible ? Theme.text : Theme.muted;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-description: root.description;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.interactive;
    activated => { root.toggled(!root.checked); }
    Rectangle {
        x: root.checked ? root.width - 16px : 4px;
        y: 4px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.checked && root.interactive ? Theme.on-accent : Theme.muted;
    }
}

component ChoiceButton inherits FocusButton {
    in property <string> label;
    in property <bool> selected;
    height: 30px;
    vertical-stretch: 0;
    min-width: 56px;
    border-radius: 4px;
    // The hover tint must show on a card, which is itself Theme.card.
    background: root.selected ? Theme.accent : (root.hovered ? Theme.text.with-alpha(0.08) : transparent);
    border-width: root.focus-visible ? 2px : 1px;
    border-color: root.focus-visible ? Theme.text : Theme.card-border;
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-enabled: root.interactive;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.label;
            color: root.selected ? Theme.on-accent : Theme.text;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
            // The button already carries the label.
            accessible-role: none;
        }
    }
}

// A push button in a row. `label` is what a screen reader says; `shown` is the short text drawn.
component ActionButton inherits FocusButton {
    in property <string> label;
    in property <string> shown;
    height: 30px;
    vertical-stretch: 0;
    min-width: 56px;
    border-radius: 4px;
    opacity: root.interactive ? 1 : 0.5;
    background: root.hovered && root.interactive ? Theme.text.with-alpha(0.08) : transparent;
    border-width: root.focus-visible ? 2px : 1px;
    border-color: root.focus-visible ? Theme.text : Theme.card-border;
    accessible-label: root.label;
    accessible-enabled: root.interactive;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.shown;
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
            // The button already carries the label.
            accessible-role: none;
        }
    }
}

// One tint colour as a square: its fill, and an accent ring while it is the chosen one. `plus`
// draws "+" instead of the fill ("Custom colour" before a custom colour is chosen).
component TintSwatch inherits FocusButton {
    in property <string> label;
    in property <color> fill;
    in property <bool> selected;
    in property <bool> plus;
    width: 28px;
    height: 28px;
    vertical-stretch: 0;
    border-radius: 6px;
    opacity: root.interactive ? 1 : 0.5;
    border-width: root.focus-visible || root.selected ? 2px : 1px;
    border-color: root.focus-visible ? Theme.text : (root.selected ? Theme.accent : Theme.card-border);
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-enabled: root.interactive;
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: 3px;
        background: root.plus ? transparent : root.fill;
        border-width: 1px;
        border-color: Theme.card-border;
    }
    if root.plus : Text {
        text: "+";
        color: Theme.text;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
        // The swatch already carries the label.
        accessible-role: none;
    }
}

// One choice out of a few, as a row of buttons, announced as a group ("Refresh rate").
export component Choice inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <[string]> options;
    in property <int> selected;
    in property <bool> interactive: true;
    callback chosen(int);
    // One of the buttons got keyboard focus.
    callback focus-gained();
    vertical-stretch: 0;
    accessible-role: groupbox;
    accessible-label: root.label;
    accessible-description: root.description;
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        max-width: 16384px; // see MetersRow: repeaters must not cap the window width
        for o[i] in root.options : ChoiceButton {
            label: o;
            selected: i == root.selected;
            interactive: root.interactive;
            activated => { root.chosen(i); }
            focus-gained => { root.focus-gained(); }
        }
    }
}

// A card: title and description on the left (the description wraps), the control on the right,
// and an optional one-line note under the description. The control carries the title as its
// label and the description as its accessible description, so those two Texts are not read
// out again; the note is.
export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> note;
    // False for a setting that is not offered yet: its title is dimmed.
    in property <bool> available: true;
    min-height: 64px;
    vertical-stretch: 0;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card;
    HorizontalLayout {
        padding: 12px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            title := Text {
                text: root.title;
                color: root.available ? Theme.text : Theme.muted;
                font-size: 13px;
                font-weight: 600;
                wrap: word-wrap;
                accessible-role: none;
            }
            if root.description != "" : description := Text {
                text: root.description;
                color: Theme.muted;
                font-size: 11px;
                wrap: word-wrap;
                accessible-role: none;
            }
            if root.note != "" : Text { text: root.note; color: Theme.text; font-size: 11px; wrap: word-wrap; }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            @children
        }
    }
}

// A titled group of Settings rows (crate::settings::SETTING_GROUPS) that opens and closes from
// its header. The owner keeps the open state: the header only asks (`toggled`).
export component SettingGroup inherits VerticalLayout {
    in property <string> title;
    in property <string> summary;
    in property <bool> open;
    in property <bool> interactive: true;
    // False while a search shows the group: the header then shows it open and does nothing.
    in property <bool> toggleable: true;
    callback toggled();
    // The header got keyboard focus; the scrolling owner brings it into view.
    callback focus-gained();
    spacing: 10px;
    vertical-stretch: 0;
    header := FocusButton {
        min-height: 44px;
        vertical-stretch: 0;
        border-radius: 4px;
        interactive: root.interactive;
        background: self.hovered && root.interactive ? Theme.text.with-alpha(0.06) : transparent;
        border-width: self.focus-visible ? 2px : 0px;
        border-color: Theme.text;
        accessible-label: root.title;
        accessible-description: root.summary;
        accessible-expandable: true;
        accessible-expanded: root.open;
        accessible-enabled: root.interactive;
        // Slint has no collapse action: expand only opens, the default action toggles.
        accessible-action-expand => {
            if (root.interactive && root.toggleable && !root.open) {
                root.toggled();
            }
        }
        activated => {
            if (root.toggleable) {
                root.toggled();
            }
        }
        focus-gained => { root.focus-gained(); }
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 12px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                    wrap: word-wrap;
                    // The header already carries the title and summary.
                    accessible-role: none;
                }
                summary := Text {
                    text: root.summary;
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    accessible-role: none;
                }
            }
            VerticalLayout {
                horizontal-stretch: 0;
                alignment: center;
                // Drawn: glyphs render as tofu in Segoe UI Variable (see rail.slint).
                chevron := Path {
                    width: 10px;
                    height: 10px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: root.open ? "M 1 3 L 5 7 L 9 3" : "M 3 1 L 7 5 L 3 9";
                    stroke: Theme.muted;
                    stroke-width: 1.5px;
                    fill: transparent;
                }
            }
        }
    }
    // The owner puts its rows here only while `open` (@children cannot be conditional).
    @children
}

export component SettingsPage inherits VerticalLayout {
    in property <int> refresh;
    in property <int> theme;
    // The system backdrop (crate::settings::BackdropChoice): 0 Mica, 1 Acrylic.
    in property <int> backdrop;
    in property <bool> always-on-top;
    in property <bool> keep-in-tray;
    // Graphs scroll continuously between samples (crate::smooth).
    in property <bool> smooth-graphs;
    // The Overview groups apps by type (crate::controls::Controls::grouped).
    in property <bool> group-by-type;
    // The tray icon draws the CPU graph (crate::tray).
    in property <bool> tray-cpu;
    // Ctrl+Alt+Shift+Esc opens the window picker (crate::shortcut); whether another program
    // already holds the keys.
    in property <bool> picker-shortcut;
    in property <bool> shortcut-taken;
    // The saved GPU choice; whether an automatic fallback to the CPU is recorded; whether this
    // instance draws with the GPU; whether SLINT_BACKEND chose the renderer (crate::settingspage).
    in property <bool> gpu-rendering;
    in property <bool> gpu-fallback;
    in property <bool> gpu-running;
    in property <bool> gpu-env-override;
    // This process is the installed copy (crate::install); the integration and update rows are
    // offered only then. Admin mode: 0 off, 1 on, 2 needs repair, 3 not available on this account.
    in property <bool> installed;
    in property <int> admin-mode-state;
    in property <bool> hotkey;
    in property <bool> start-with-windows;
    in property <bool> check-updates;
    // The manual check's outcome (crate::update::Updater), shown under its row.
    in property <string> update-status;
    in property <string> version-text;
    in property <bool> pawnio-installed: false;
    in property <bool> interactive: true;
    // Which groups are open, in crate::settings::SETTING_GROUPS order.
    in property <[bool]> groups-open;
    callback group-toggled(int);
    // Whether a row with this title and description matches the search (crate::settings::setting_matches).
    pure callback setting-matches(string, string, string) -> bool;
    property <string> search-text;
    // Each row's title and description (its control reads them out) and whether it matches the
    // search; a group shows while any of its rows does. The Tint rows exist with Acrylic only.
    // Blank (only spaces) is not a search: Rust trims it to nothing, which matches every row.
    property <bool> searching: root.search-text != "" && !root.setting-matches(root.search-text, "", "");
    property <string> theme-row-title: "Theme";
    property <string> theme-row-desc: "System follows Windows' light or dark mode.";
    property <bool> theme-row-hit: !root.searching || root.setting-matches(root.search-text, root.theme-row-title, root.theme-row-desc);
    property <string> backdrop-row-title: "Backdrop";
    property <string> backdrop-row-desc: "Mica takes its colour from the desktop background. Acrylic blurs the windows behind Negotium. Needs GPU rendering.";
    property <bool> backdrop-row-hit: !root.searching || root.setting-matches(root.search-text, root.backdrop-row-title, root.backdrop-row-desc);
    property <string> tint-row-title: "Tint colour";
    property <string> tint-row-desc: "The colour on top of Acrylic. Default colour follows light or dark mode.";
    property <bool> tint-row-hit: root.backdrop == 1 && (!root.searching || root.setting-matches(root.search-text, root.tint-row-title, root.tint-row-desc));
    property <string> opacity-row-title: "Tint opacity";
    property <string> opacity-row-desc: "Move to the left to see more of the windows behind Negotium. Move to the right for a stronger tint.";
    property <bool> opacity-row-hit: root.backdrop == 1 && (!root.searching || root.setting-matches(root.search-text, root.opacity-row-title, root.opacity-row-desc));
    property <string> smooth-row-title: "Smooth graphs";
    property <string> smooth-row-desc: "Graphs scroll continuously between updates instead of stepping. Turn off to use a little less CPU.";
    property <bool> smooth-row-hit: !root.searching || root.setting-matches(root.search-text, root.smooth-row-title, root.smooth-row-desc);
    property <bool> appearance-hit: root.theme-row-hit || root.backdrop-row-hit || root.tint-row-hit || root.opacity-row-hit || root.smooth-row-hit;
    property <string> top-row-title: "Always on top";
    property <string> top-row-desc: "Keep Negotium above other windows.";
    property <bool> top-row-hit: !root.searching || root.setting-matches(root.search-text, root.top-row-title, root.top-row-desc);
    property <string> tray-row-title: "Keep running in the tray when closed";
    property <string> tray-row-desc: "Closing the window keeps Negotium in the notification area: history keeps recording and reopening is instant.";
    property <bool> tray-row-hit: !root.searching || root.setting-matches(root.search-text, root.tray-row-title, root.tray-row-desc);
    property <string> tray-cpu-row-title: "Show CPU in tray icon";
    property <string> tray-cpu-row-desc: "The tray icon draws the last minute of CPU use; point at it to see the current value.";
    property <bool> tray-cpu-row-hit: !root.searching || root.setting-matches(root.search-text, root.tray-cpu-row-title, root.tray-cpu-row-desc);
    property <bool> window-hit: root.top-row-hit || root.tray-row-hit || root.tray-cpu-row-hit;
    property <string> refresh-row-title: "Refresh rate";
    property <string> refresh-row-desc: "How often numbers update while the window is open. In the tray Negotium updates every 2 s, or slower if you choose a slower rate.";
    property <bool> refresh-row-hit: !root.searching || root.setting-matches(root.search-text, root.refresh-row-title, root.refresh-row-desc);
    property <string> group-row-title: "Group apps by type";
    property <string> group-row-desc: "Apps, background processes and Windows processes under their own headings";
    property <bool> group-row-hit: !root.searching || root.setting-matches(root.search-text, root.group-row-title, root.group-row-desc);
    property <string> aequilibrium-row-title: "Aequilibrium (Runaway CPU restraint)";
    property <string> aequilibrium-row-desc: "Automatically throttles background processes consuming high CPU when the system is under pressure, keeping the desktop responsive.";
    property <bool> aequilibrium-row-hit: !root.searching || root.setting-matches(root.search-text, root.aequilibrium-row-title, root.aequilibrium-row-desc);
    property <bool> processes-hit: root.refresh-row-hit || root.group-row-hit || root.aequilibrium-row-hit;
    property <string> start-row-title: "Start with Windows";
    property <string> start-row-desc: "Open Negotium in the tray when you sign in.";
    property <bool> start-row-hit: !root.searching || root.setting-matches(root.search-text, root.start-row-title, root.start-row-desc);
    property <string> admin-row-title: "Admin mode";
    property <string> admin-row-desc: "Start with admin rights without a prompt. Anything that can start Negotium can then open it with admin rights, without a prompt.";
    property <bool> admin-row-hit: !root.searching || root.setting-matches(root.search-text, root.admin-row-title, root.admin-row-desc);
    property <string> hotkey-row-title: "Open on Ctrl+Shift+Esc";
    property <string> hotkey-row-desc: "Open Negotium instead of Task Manager. Turning this on replaces another tool's Task Manager replacement, such as Process Explorer's.";
    property <bool> hotkey-row-hit: !root.searching || root.setting-matches(root.search-text, root.hotkey-row-title, root.hotkey-row-desc);
    property <string> picker-row-title: "Pick a window to end on Ctrl+Alt+Shift+Esc";
    property <string> picker-row-desc: "Press the keys, then click a window to end its app. Shift+click ends it with no question.";
    property <bool> picker-row-hit: !root.searching || root.setting-matches(root.search-text, root.picker-row-title, root.picker-row-desc);
    property <bool> startup-hit: root.start-row-hit || root.admin-row-hit || root.hotkey-row-hit || root.picker-row-hit;
    property <string> updates-row-title: "Check for updates on startup";
    property <string> updates-row-desc: "Look for a newer version of Negotium each time it starts.";
    property <bool> updates-row-hit: !root.searching || root.setting-matches(root.search-text, root.updates-row-title, root.updates-row-desc);
    property <string> check-row-title: "Check for updates now";
    property <string> check-row-desc: "Look for a newer version of Negotium.";
    property <bool> check-row-hit: !root.searching || root.setting-matches(root.search-text, root.check-row-title, root.check-row-desc);
    property <bool> updates-hit: root.updates-row-hit || root.check-row-hit;
    property <string> temp-row-title: "CPU temperature add-on";
    property <string> temp-row-desc: "Show the CPU temperature (installs the PawnIO driver from its publisher).";
    property <bool> temp-row-hit: !root.searching || root.setting-matches(root.search-text, root.temp-row-title, root.temp-row-desc);
    property <bool> addons-hit: root.temp-row-hit;
    property <string> gpu-row-title: "Use GPU rendering";
    property <string> gpu-row-desc: "Draw the window with the graphics card: smoother resizing. Turn off if the window shows glitches.";
    property <bool> gpu-row-hit: !root.searching || root.setting-matches(root.search-text, root.gpu-row-title, root.gpu-row-desc);
    property <string> taskmgr-row-title: "Windows Task Manager";
    property <string> taskmgr-row-desc: "Open the original Task Manager, whatever Ctrl+Shift+Esc does.";
    property <bool> taskmgr-row-hit: !root.searching || root.setting-matches(root.search-text, root.taskmgr-row-title, root.taskmgr-row-desc);
    property <bool> advanced-hit: root.gpu-row-hit || root.taskmgr-row-hit;
    property <bool> any-hit: root.appearance-hit || root.window-hit || root.processes-hit || root.startup-hit || root.updates-hit || root.addons-hit || root.advanced-hit;
    // Room kept free below the last row (the floating toast), so it can be scrolled clear.
    in property <length> bottom-inset;
    callback refresh-chosen(int);
    callback theme-chosen(int);
    callback backdrop-chosen(int);
    // Tint colour (Acrylic only): a swatch's colour, "Default colour" (the mode's own), the
    // opacity slider's value (percent), and "Custom colour" (the owner opens the picker).
    callback tint-chosen(color);
    callback tint-default-chosen();
    callback tint-opacity-chosen(float);
    callback custom-tint-requested();
    callback always-on-top-toggled(bool);
    callback tray-toggled(bool);
    callback smooth-graphs-toggled(bool);
    callback group-by-type-toggled(bool);
    callback tray-cpu-toggled(bool);
    callback picker-shortcut-toggled(bool);
    callback gpu-rendering-toggled(bool);
    callback admin-mode-toggled(bool);
    callback hotkey-toggled(bool);
    callback start-with-windows-toggled(bool);
    callback check-updates-toggled(bool);
    callback check-updates-now();
    callback open-windows-task-manager();
    in property <bool> aequilibrium-enabled: true;
    callback aequilibrium-toggled(bool);
    // A recorded fallback keeps the CPU renderer whatever the setting says: the switch shows off.
    property <bool> gpu-shown: root.gpu-rendering && !root.gpu-fallback;
    // The tint swatches after "Default colour"; a swatch gives its colour, Rust saves it.
    property <[{label: string, color: color}]> tint-presets: [
        { label: "Black", color: #000000 },
        { label: "White", color: #ffffff },
        { label: "Blue", color: #0078d4 },
        { label: "Purple", color: #744da9 },
        { label: "Green", color: #107c10 },
        { label: "Red", color: #c42b1c },
    ];
    // A chosen tint that is none of the presets: "Custom colour" is the chosen swatch.
    // ponytail: one `!=` per preset; a new preset needs its term here too.
    property <bool> tint-custom: Theme.tint-color-set
        && Theme.tint-color != root.tint-presets[0].color && Theme.tint-color != root.tint-presets[1].color
        && Theme.tint-color != root.tint-presets[2].color && Theme.tint-color != root.tint-presets[3].color
        && Theme.tint-color != root.tint-presets[4].color && Theme.tint-color != root.tint-presets[5].color;
    max-width: 16384px;

    // A control reached with Tab is never out of sight: its whole row scrolls into view.
    sv := RevealScrollView {
        // Content width: the view less a gutter the scrollbar always gets (as on the Performance
        // page). Not visible-width: the wrapped descriptions' height decides whether the
        // scrollbar shows, so a width that depended on the scrollbar could flip back and forth.
        property <length> content-w: max(0px, self.width - 14px);
        content-width: self.content-w;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            width: sv.content-w;
            height: sv.content-height;
            padding: 24px;
            padding-bottom: 24px + root.bottom-inset;
            spacing: 10px;
            // Spare height stays empty below the last row.
            alignment: start;
            Text { text: "Settings"; color: Theme.text; font-size: 24px; font-weight: 600; vertical-stretch: 0; }
            LineEdit {
                text <=> root.search-text;
                placeholder-text: "Search settings";
                accessible-label: "Search settings";
                enabled: root.interactive;
            }
            if !root.any-hit : Text {
                text: "No settings match your search.";
                color: Theme.muted;
                font-size: 13px;
                vertical-stretch: 0;
            }
            if root.appearance-hit : appearance-group := SettingGroup {
                title: "Appearance";
                summary: "Theme, backdrop, tint and graphs";
                open: root.searching || root.groups-open[0];
                interactive: root.interactive;
                toggleable: !root.searching;
                toggled => { root.group-toggled(0); }
                focus-gained => { sv.reveal(appearance-group.absolute-position.y, 44px); }
                if root.searching || root.groups-open[0] : VerticalLayout {
                    spacing: 10px;
                    if root.theme-row-hit : theme-row := SettingRow {
                        title: root.theme-row-title;
                        description: root.theme-row-desc;
                        Choice {
                            label: theme-row.title;
                            description: theme-row.description;
                            options: ["System", "Light", "Dark"];
                            selected: root.theme;
                            interactive: root.interactive;
                            chosen(i) => { root.theme-chosen(i); }
                            focus-gained => { sv.reveal(theme-row.absolute-position.y, theme-row.height); }
                        }
                    }
                    if root.backdrop-row-hit : backdrop-row := SettingRow {
                        title: root.backdrop-row-title;
                        description: root.backdrop-row-desc;
                        Choice {
                            label: backdrop-row.title;
                            description: backdrop-row.description;
                            options: ["Mica", "Acrylic"];
                            selected: root.backdrop;
                            interactive: root.interactive;
                            chosen(i) => { root.backdrop-chosen(i); }
                            focus-gained => { sv.reveal(backdrop-row.absolute-position.y, backdrop-row.height); }
                        }
                    }
                    // The layer Negotium draws over Acrylic (Theme.acrylic-tint); Mica has none.
                    if root.tint-row-hit : tint-row := SettingRow {
                        title: root.tint-row-title;
                        description: root.tint-row-desc;
                        Rectangle {
                            accessible-role: groupbox;
                            accessible-label: tint-row.title;
                            accessible-description: tint-row.description;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                max-width: 16384px; // see MetersRow: repeaters must not cap the window width
                                TintSwatch {
                                    label: "Default colour";
                                    fill: Theme.tint-default;
                                    selected: !Theme.tint-color-set;
                                    interactive: root.interactive;
                                    activated => { root.tint-default-chosen(); }
                                    focus-gained => { sv.reveal(tint-row.absolute-position.y, tint-row.height); }
                                }
                                for preset in root.tint-presets : TintSwatch {
                                    label: preset.label;
                                    fill: preset.color;
                                    selected: Theme.tint-color-set && Theme.tint-color == preset.color;
                                    interactive: root.interactive;
                                    activated => { root.tint-chosen(preset.color); }
                                    focus-gained => { sv.reveal(tint-row.absolute-position.y, tint-row.height); }
                                }
                                TintSwatch {
                                    label: "Custom colour";
                                    fill: Theme.tint-color;
                                    plus: !root.tint-custom;
                                    selected: root.tint-custom;
                                    interactive: root.interactive;
                                    activated => { root.custom-tint-requested(); }
                                    focus-gained => { sv.reveal(tint-row.absolute-position.y, tint-row.height); }
                                }
                            }
                        }
                    }
                    if root.opacity-row-hit : opacity-row := SettingRow {
                        title: root.opacity-row-title;
                        description: root.opacity-row-desc;
                        // One-way: a drag breaks the binding, and the opacity is then a saved percent that
                        // no longer follows the mode, so the two agree. Rust saves only a new percent.
                        Slider {
                            width: 200px;
                            minimum: 0;
                            maximum: 100;
                            value: Theme.tint-percent;
                            enabled: root.interactive;
                            accessible-label: opacity-row.title;
                            accessible-description: opacity-row.description;
                            changed(v) => { root.tint-opacity-chosen(v); }
                            changed has-focus => {
                                if (self.has-focus) {
                                    sv.reveal(opacity-row.absolute-position.y, opacity-row.height);
                                }
                            }
                        }
                    }
                    if root.smooth-row-hit : smooth-row := SettingRow {
                        title: root.smooth-row-title;
                        description: root.smooth-row-desc;
                        Toggle {
                            label: smooth-row.title;
                            description: smooth-row.description;
                            checked: root.smooth-graphs;
                            interactive: root.interactive;
                            toggled(on) => { root.smooth-graphs-toggled(on); }
                            focus-gained => { sv.reveal(smooth-row.absolute-position.y, smooth-row.height); }
                        }
                    }
                }
            }
            if root.window-hit : window-group := SettingGroup {
                title: "Window and tray";
                summary: "Always on top and the tray icon";
                open: root.searching || root.groups-open[1];
                interactive: root.interactive;
                toggleable: !root.searching;
                toggled => { root.group-toggled(1); }
                focus-gained => { sv.reveal(window-group.absolute-position.y, 44px); }
                if root.searching || root.groups-open[1] : VerticalLayout {
                    spacing: 10px;
                    if root.top-row-hit : top-row := SettingRow {
                        title: root.top-row-title;
                        description: root.top-row-desc;
                        Toggle {
                            label: top-row.title;
                            description: top-row.description;
                            checked: root.always-on-top;
                            interactive: root.interactive;
                            toggled(on) => { root.always-on-top-toggled(on); }
                            focus-gained => { sv.reveal(top-row.absolute-position.y, top-row.height); }
                        }
                    }
                    if root.tray-row-hit : tray-row := SettingRow {
                        title: root.tray-row-title;
                        description: root.tray-row-desc;
                        Toggle {
                            label: tray-row.title;
                            description: tray-row.description;
                            checked: root.keep-in-tray;
                            interactive: root.interactive;
                            toggled(on) => { root.tray-toggled(on); }
                            focus-gained => { sv.reveal(tray-row.absolute-position.y, tray-row.height); }
                        }
                    }
                    if root.tray-cpu-row-hit : tray-cpu-row := SettingRow {
                        title: root.tray-cpu-row-title;
                        description: root.tray-cpu-row-desc;
                        Toggle {
                            label: tray-cpu-row.title;
                            description: tray-cpu-row.description;
                            checked: root.tray-cpu;
                            interactive: root.interactive;
                            toggled(on) => { root.tray-cpu-toggled(on); }
                            focus-gained => { sv.reveal(tray-cpu-row.absolute-position.y, tray-cpu-row.height); }
                        }
                    }
                }
            }
            if root.processes-hit : processes-group := SettingGroup {
                title: "Processes";
                summary: "Refresh rate, grouping and Aequilibrium";
                open: root.searching || root.groups-open[2];
                interactive: root.interactive;
                toggleable: !root.searching;
                toggled => { root.group-toggled(2); }
                focus-gained => { sv.reveal(processes-group.absolute-position.y, 44px); }
                if root.searching || root.groups-open[2] : VerticalLayout {
                    spacing: 10px;
                    if root.refresh-row-hit : refresh-row := SettingRow {
                        title: root.refresh-row-title;
                        description: root.refresh-row-desc;
                        Choice {
                            label: refresh-row.title;
                            description: refresh-row.description;
                            options: ["0.5 s", "1 s", "2 s", "5 s"];
                            selected: root.refresh;
                            interactive: root.interactive;
                            chosen(i) => { root.refresh-chosen(i); }
                            focus-gained => { sv.reveal(refresh-row.absolute-position.y, refresh-row.height); }
                        }
                    }
                    if root.group-row-hit : group-row := SettingRow {
                        title: root.group-row-title;
                        description: root.group-row-desc;
                        Toggle {
                            label: group-row.title;
                            description: group-row.description;
                            checked: root.group-by-type;
                            interactive: root.interactive;
                            toggled(on) => { root.group-by-type-toggled(on); }
                            focus-gained => { sv.reveal(group-row.absolute-position.y, group-row.height); }
                        }
                    }
                    if root.aequilibrium-row-hit : aequilibrium-row := SettingRow {
                        title: root.aequilibrium-row-title;
                        description: root.aequilibrium-row-desc;
                        Toggle {
                            label: aequilibrium-row.title;
                            description: aequilibrium-row.description;
                            checked: root.aequilibrium-enabled;
                            interactive: root.interactive;
                            toggled(on) => { root.aequilibrium-toggled(on); }
                            focus-gained => { sv.reveal(aequilibrium-row.absolute-position.y, aequilibrium-row.height); }
                        }
                    }
                }
            }
            if root.startup-hit : startup-group := SettingGroup {
                title: "Startup and shortcuts";
                summary: "Start with Windows, admin mode and shortcut keys";
                open: root.searching || root.groups-open[3];
                interactive: root.interactive;
                toggleable: !root.searching;
                toggled => { root.group-toggled(3); }
                focus-gained => { sv.reveal(startup-group.absolute-position.y, 44px); }
                if root.searching || root.groups-open[3] : VerticalLayout {
                    spacing: 10px;
                    if root.start-row-hit : start-row := SettingRow {
                        title: root.start-row-title;
                        description: root.start-row-desc;
                        note: root.installed ? "" : "Install Negotium to use this";
                        available: root.installed;
                        Toggle {
                            label: start-row.title;
                            description: root.installed ? start-row.description : "Install Negotium to use this";
                            checked: root.installed && root.start-with-windows;
                            interactive: root.interactive && root.installed;
                            toggled(on) => { root.start-with-windows-toggled(on); }
                            focus-gained => { sv.reveal(start-row.absolute-position.y, start-row.height); }
                        }
                    }
                    if root.admin-row-hit : admin-row := SettingRow {
                        title: root.admin-row-title;
                        description: root.admin-row-desc;
                        note: !root.installed ? "Install Negotium to use this"
                            : root.admin-mode-state == 2 ? "Needs repair. Turn on again to repair"
                            : root.admin-mode-state == 3 ? "Needs an administrator account" : "";
                        available: root.installed && root.admin-mode-state != 3;
                        Toggle {
                            label: admin-row.title;
                            description: !root.installed ? "Install Negotium to use this"
                                : root.admin-mode-state == 2 ? "Turn on again to repair"
                                : root.admin-mode-state == 3 ? "Needs an administrator account" : admin-row.description;
                            checked: root.installed && root.admin-mode-state == 1;
                            interactive: root.interactive && root.installed && root.admin-mode-state != 3;
                            toggled(on) => { root.admin-mode-toggled(on); }
                            focus-gained => { sv.reveal(admin-row.absolute-position.y, admin-row.height); }
                        }
                    }
                    if root.hotkey-row-hit : hotkey-row := SettingRow {
                        title: root.hotkey-row-title;
                        description: root.hotkey-row-desc;
                        note: root.installed ? "" : "Install Negotium to use this";
                        available: root.installed;
                        Toggle {
                            label: hotkey-row.title;
                            description: root.installed ? hotkey-row.description : "Install Negotium to use this";
                            checked: root.installed && root.hotkey;
                            interactive: root.interactive && root.installed;
                            toggled(on) => { root.hotkey-toggled(on); }
                            focus-gained => { sv.reveal(hotkey-row.absolute-position.y, hotkey-row.height); }
                        }
                    }
                    if root.picker-row-hit : picker-row := SettingRow {
                        title: root.picker-row-title;
                        description: root.shortcut-taken
                            ? "Another program uses Ctrl+Alt+Shift+Esc"
                            : root.picker-row-desc;
                        Toggle {
                            label: picker-row.title;
                            description: picker-row.description;
                            checked: root.picker-shortcut;
                            interactive: root.interactive;
                            toggled(on) => { root.picker-shortcut-toggled(on); }
                            focus-gained => { sv.reveal(picker-row.absolute-position.y, picker-row.height); }
                        }
                    }
                }
            }
            if root.updates-hit : updates-group := SettingGroup {
                title: "Updates";
                summary: "Update checks";
                open: root.searching || root.groups-open[4];
                interactive: root.interactive;
                toggleable: !root.searching;
                toggled => { root.group-toggled(4); }
                focus-gained => { sv.reveal(updates-group.absolute-position.y, 44px); }
                if root.searching || root.groups-open[4] : VerticalLayout {
                    spacing: 10px;
                    if root.updates-row-hit : updates-row := SettingRow {
                        title: root.updates-row-title;
                        description: root.updates-row-desc;
                        note: root.installed ? "" : "Install Negotium to use this";
                        available: root.installed;
                        Toggle {
                            label: updates-row.title;
                            description: root.installed ? updates-row.description : "Install Negotium to use this";
                            checked: root.installed && root.check-updates;
                            interactive: root.interactive && root.installed;
                            toggled(on) => { root.check-updates-toggled(on); }
                            focus-gained => { sv.reveal(updates-row.absolute-position.y, updates-row.height); }
                        }
                    }
                    if root.check-row-hit : check-row := SettingRow {
                        title: root.check-row-title;
                        description: root.check-row-desc;
                        note: root.installed ? root.update-status : "Install Negotium to use this";
                        available: root.installed;
                        ActionButton {
                            label: "Check for updates";
                            shown: "Check";
                            interactive: root.interactive && root.installed;
                            activated => { root.check-updates-now(); }
                            focus-gained => { sv.reveal(check-row.absolute-position.y, check-row.height); }
                        }
                    }
                }
            }
            if root.addons-hit : addons-group := SettingGroup {
                title: "Add-ons";
                summary: "CPU temperature";
                open: root.searching || root.groups-open[5];
                interactive: root.interactive;
                toggleable: !root.searching;
                toggled => { root.group-toggled(5); }
                focus-gained => { sv.reveal(addons-group.absolute-position.y, 44px); }
                if root.searching || root.groups-open[5] : VerticalLayout {
                    spacing: 10px;
                    if !root.pawnio-installed && root.temp-row-hit : Text { text: "Coming in a later version"; color: Theme.muted; font-size: 12px; vertical-stretch: 0; }
                    if root.temp-row-hit : temp-row := SettingRow {
                        title: root.temp-row-title;
                        description: root.temp-row-desc;
                        note: root.pawnio-installed ? "PawnIO driver detected and active" : "";
                        available: root.pawnio-installed;
                        Toggle {
                            label: temp-row.title;
                            description: root.pawnio-installed ? temp-row.description : "Coming in a later version";
                            checked: root.pawnio-installed;
                            interactive: false;
                        }
                    }
                }
            }
            if root.advanced-hit : advanced-group := SettingGroup {
                title: "Advanced";
                summary: "GPU rendering and Windows Task Manager";
                open: root.searching || root.groups-open[6];
                interactive: root.interactive;
                toggleable: !root.searching;
                toggled => { root.group-toggled(6); }
                focus-gained => { sv.reveal(advanced-group.absolute-position.y, 44px); }
                if root.searching || root.groups-open[6] : VerticalLayout {
                    spacing: 10px;
                    if root.gpu-row-hit : gpu-row := SettingRow {
                        title: root.gpu-row-title;
                        description: root.gpu-row-desc;
                        note: root.gpu-fallback
                            ? "Switched to CPU rendering because the graphics driver didn't respond. Turn on to try the GPU again."
                            : root.gpu-env-override
                            ? "Overridden by SLINT_BACKEND."
                            : (root.gpu-shown != root.gpu-running ? "Takes effect when Negotium restarts." : "");
                        Toggle {
                            label: gpu-row.title;
                            description: gpu-row.description;
                            checked: root.gpu-shown;
                            interactive: root.interactive;
                            toggled(on) => { root.gpu-rendering-toggled(on); }
                            focus-gained => { sv.reveal(gpu-row.absolute-position.y, gpu-row.height); }
                        }
                    }
                    if root.taskmgr-row-hit : taskmgr-row := SettingRow {
                        title: root.taskmgr-row-title;
                        description: root.taskmgr-row-desc;
                        ActionButton {
                            label: "Open Windows Task Manager";
                            shown: "Open";
                            interactive: root.interactive;
                            activated => { root.open-windows-task-manager(); }
                            focus-gained => { sv.reveal(taskmgr-row.absolute-position.y, taskmgr-row.height); }
                        }
                    }
                }
            }
            Text { text: root.version-text; color: Theme.muted; font-size: 12px; vertical-stretch: 0; }
        }
    }
}
