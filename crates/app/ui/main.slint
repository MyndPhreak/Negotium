import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MetersRow, MeterData } from "meters.slint";
import { TopStrip, TileData } from "topstrip.slint";
import { AppList, RowData } from "applist.slint";
import { Banner, Toast, Modal, RunTaskModal, CpuAffinityModal, CpuPriorityModal, CoreItem } from "overlays.slint";
import { Rail } from "rail.slint";
import { PerformancePage, DeviceData, StatData, SegmentData } from "perfpage.slint";
import { SettingsPage } from "settingspage.slint";
import { StartupPage, StartupData } from "startuppage.slint";
import { AppHistoryPage, AppHistoryData } from "apphistorypage.slint";
import { ServicesPage, ServiceData } from "servicespage.slint";
import { GraphData, ScrubRow, GraphClock } from "graph.slint";
export { NegotiumTray } from "tray.slint";
export { Theme, MeterData, TileData, RowData, DeviceData, GraphData, StatData, SegmentData, ScrubRow, StartupData, AppHistoryData, ServiceData, GraphClock }

export component MainWindow inherits Window {
    title: "Negotium";
    icon: @image-url("../assets/negotium.svg");
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 440px;
    default-font-family: "Segoe UI Variable Text";
    background: Theme.window-bg;

    // Page shown: 0 Overview, 1 Performance, 2 Startup, 3 Settings, 4 AppHistory, 5 Services (crate::controls::Page).
    in-out property <int> page: 0;
    in property <[MeterData]> meters;
    in property <int> selected-metric;
    in property <[TileData]> tiles;
    in property <string> top-caption;
    in property <[RowData]> rows;
    in property <bool> show-admin-banner;
    in-out property <string> search-text;
    in property <string> toast;
    in-out property <string> confirm-text;
    in-out property <bool> confirm-visible;
    in-out property <string> details-text;
    in-out property <bool> details-visible;
    in-out property <bool> run-task-visible;
    in-out property <string> run-task-command;
    in-out property <string> run-task-working-dir;
    in property <bool> windows-sandbox-available: true;
    in property <[DeviceData]> perf-devices;
    in-out property <string> perf-selected: "cpu";
    in property <string> perf-title;
    in property <string> perf-subtitle;
    in property <string> perf-note;
    in property <[GraphData]> perf-graphs;
    in property <[GraphData]> perf-cells;
    in property <[StatData]> perf-stats;
    in property <[SegmentData]> perf-segments;
    // Graph range: 0 = 1 min, 1 = 10 min, 2 = 1 h (crate::perf::Range).
    in-out property <int> perf-range: 0;
    // History scrub on the Performance graphs: cursor fraction (-1 = none) and the card's content.
    in property <float> scrub-x: -1;
    in property <string> scrub-title;
    in property <string> scrub-empty;
    in property <string> scrub-note;
    in property <[ScrubRow]> scrub-rows;
    // Smooth graphs (crate::smooth). The paths put each frame's newest sample at x = 1000, and
    // GraphClock moves the view's right edge from `lead-ms` toward it. This timer advances the
    // clock while the window is shown on a page with graphs, as often as the widest scrolling
    // graph there needs to move a whole physical pixel (crate::smooth::redraw_hz): at most about
    // 60 times a second, far less for the narrow sparklines and the long ranges, never less than
    // once a second. It only moves the view: the paths change only when a frame lands.
    in property <float> perf-span-ms: 60000;
    property <length> scroll-width: root.page == 0 ? meters-row.spark-width : perf.graph-width;
    property <float> scroll-span-ms: root.page == 0 ? 60000 : root.perf-span-ms;
    // max(1, …): before Rust installs redraw-hz it answers 0, and the timer then runs once a second.
    // Not the run's speed: setting a running Timer's interval re-arms it from now, and the speed
    // changes with nearly every frame, so a slow graph would move only when frames land. The rate
    // depends on the width, the span and the page alone (crate::smooth::install).
    out property <duration> scroll-interval: 1000ms / max(1, GraphClock.redraw-hz(root.scroll-width / 1phx, root.scroll-span-ms));
    Timer {
        interval: root.scroll-interval;
        running: GraphClock.live && root.page <= 1 && GraphClock.offset-ms < 0;
        triggered => {
            GraphClock.now = GraphClock.clock();
            // The view moved under a still pointer: the scrub card follows (crate::bridge).
            if (root.scrub-x >= 0) {
                root.scroll-follow();
            }
        }
    }
    // A frame's graphs landed (crate::smooth::Scroll): the view's right edge starts `lead-ms`
    // before their newest sample and moves `speed` ms of graph time per ms; (0, 0) rests it on
    // the newest sample. A function, not a `changed` handler: the new paths and their offset
    // reach the same rendered frame.
    public function scroll-from(lead-ms: float, speed: float) {
        GraphClock.anchor = GraphClock.clock();
        GraphClock.now = GraphClock.anchor;
        GraphClock.lead-ms = lead-ms;
        GraphClock.speed = speed;
    }
    out property <bool> modal-open: confirm-visible || details-visible || run-task-visible || affinity-visible || priority-visible;

    in-out property <bool> affinity-visible: false;
    in-out property <string> affinity-title: "";
    in-out property <string> affinity-process-name: "";
    in-out property <[CoreItem]> affinity-cores: [];
    in-out property <bool> affinity-all-cores: true;
    in-out property <bool> affinity-can-apply: true;
    in-out property <bool> affinity-remember: false;
    callback affinity-toggle-core(int);
    callback affinity-toggle-all(bool);
    callback affinity-apply(bool);
    callback affinity-cancel();

    in-out property <bool> priority-visible: false;
    in-out property <string> priority-title: "";
    in-out property <string> priority-process-name: "";
    in-out property <int> priority-selected: 3;
    in-out property <bool> priority-remember: false;
    callback priority-apply(int, bool);
    callback priority-cancel();
    // The room the floating toast takes at the bottom of a page (its height and its gap), so the
    // end of every page (the Overview and Startup lists, the Performance and Settings scroll
    // content) can still be scrolled clear of it.
    property <length> toast-inset: toast-host.preferred-height > 0 ? toast-host.preferred-height + 12px : 0px;
    out property <int> menu-target: list.menu-target;
    // Keyboard navigation through the app list (ruling P3-7): set by the bridge.
    in property <int> current-row: -1;
    // The current row's top and height in the list (crate::bridge::row_top): rows differ in height.
    in property <length> current-row-y;
    in property <length> current-row-h;
    in property <int> current-id: -1;
    in property <bool> current-actionable;
    out property <length> list-scroll-y: list.scroll-y;

    callback select-page(int);
    callback select-metric(int);
    // The list's sort (crate::controls): -1 is the name column, 0..4 a metric's index. Clicking a
    // header reports its column; Rust answers by setting both properties.
    in-out property <int> sort-column: 0;
    in-out property <bool> sort-descending: true;
    callback sort-clicked(int);
    // Optional table columns on the Overview page.
    in-out property <bool> col-pid: false;
    in-out property <bool> col-proc-name: false;
    in-out property <bool> col-status: false;
    in-out property <bool> col-threads: false;
    in-out property <bool> col-handles: false;
    in-out property <bool> col-publisher: false;
    callback toggle-column(int);
    callback run-new-task(string, string, int, int, bool);
    callback browse-executable();
    callback enable-windows-sandbox-terminal();
    callback copy-windows-sandbox-cmd();
    callback open-tile(int);
    callback toggle-row(int);
    callback row-action(string, int);
    callback list-hover(bool);
    callback menu-open(bool);
    callback row-key-focus(int, bool);
    callback clear-key-focus();
    callback search-changed(string);
    callback restart-admin();
    callback dismiss-banner();
    callback confirm(bool);
    callback close-details();
    callback dismiss-toast();
    callback select-device(string);
    callback select-range(int);
    callback scrub(float);
    callback scroll-follow();
    callback list-focus(bool);
    callback list-key(string) -> bool;

    // Startup (crate::startup): the rows, whether a list or toggle job runs (set and cleared by
    // Rust; one job at a time), and whether the inline "Restart as admin" banner shows.
    in property <[StartupData]> startup-rows;
    in-out property <bool> startup-loading;
    in property <bool> startup-admin-banner;
    // Some list, folder or key couldn't be read (crate::startup::JobOutcome::read_error).
    in property <bool> startup-read-note;
    in-out property <int> startup-sort-column: 0;
    in-out property <bool> startup-sort-descending: false;
    callback sort-startup(int);
    callback toggle-startup(int, bool);
    callback refresh-startup();

    // App History (crate::view::AppHistoryView):
    in property <[AppHistoryData]> history-rows;
    in property <string> history-duration: "0 s";
    in-out property <int> history-sort-column: 1;
    in-out property <bool> history-sort-descending: true;
    callback sort-history(int);
    callback reset-history();

    // Services (crate::services):
    in property <[ServiceData]> service-rows;
    in-out property <bool> services-loading;
    in-out property <string> services-search-text;
    in-out property <int> services-sort-column: 0;
    in-out property <bool> services-sort-descending: false;
    callback search-services(string);
    callback sort-services(int);
    callback refresh-services();
    callback service-action(string, int);

    // Settings (crate::settings::Settings, shown by crate::settingspage): refresh index (0.5 / 1 /
    // 2 / 5 s), theme index (System / Light / Dark), the switches. `on-top` is both the window's
    // state and the switch's. The GPU switch also needs whether an automatic fallback is recorded,
    // whether this instance draws with the GPU and whether SLINT_BACKEND chose the renderer (a
    // change takes effect on the next launch).
    in-out property <int> settings-refresh: 1;
    in-out property <int> settings-theme: 0;
    in-out property <int> settings-backdrop: 0;
    in-out property <bool> on-top;
    always-on-top: root.on-top;
    in-out property <bool> settings-keep-in-tray: true;
    in-out property <bool> settings-smooth-graphs: true;
    in-out property <bool> settings-group-by-type: true;
    in-out property <bool> settings-tray-cpu: true;
    in-out property <bool> settings-picker-shortcut;
    in-out property <bool> settings-shortcut-taken;
    in-out property <bool> settings-gpu-rendering: true;
    in-out property <bool> settings-gpu-fallback;
    in property <bool> settings-gpu-running: true;
    in property <bool> settings-gpu-env-override;
    in-out property <bool> settings-pawnio-installed: false;
    in-out property <bool> settings-aequilibrium-enabled: true;
    callback settings-aequilibrium-toggled(bool);
    callback refresh-chosen(int);
    callback theme-chosen(int);
    callback backdrop-chosen(int);
    callback always-on-top-toggled(bool);
    callback tray-toggled(bool);
    callback smooth-graphs-toggled(bool);
    callback group-by-type-toggled(bool);
    callback tray-cpu-toggled(bool);
    callback picker-shortcut-toggled(bool);
    callback gpu-rendering-toggled(bool);
    // Installed copy, integration and updates (crate::install, crate::settingspage::show_install).
    // Admin mode: 0 off, 1 on, 2 needs repair, 3 not available on this account.
    in-out property <bool> settings-installed;
    in-out property <int> settings-admin-mode-state;
    in-out property <bool> settings-admin-mode: root.settings-admin-mode-state == 1;
    in-out property <bool> settings-hotkey;
    in-out property <bool> settings-start-with-windows;
    in-out property <bool> settings-check-updates: true;
    in property <string> version-text;
    callback admin-mode-toggled(bool);
    callback hotkey-toggled(bool);
    callback start-with-windows-toggled(bool);
    callback check-updates-toggled(bool);
    callback check-updates-now();
    callback open-windows-task-manager();
    // Updates (crate::update::Updater): the banner's text ("Update to vX.Y.Z"; empty: none),
    // whether the update is under way (its buttons wait), and the manual check's outcome on the
    // Settings page ("Checking…", "You're up to date", "Couldn't check for updates").
    in property <string> update-banner;
    in property <bool> update-busy;
    in property <string> settings-update-status;
    callback update-accepted();
    callback update-dismissed();
    // Settings > Theme: Rust passes the effective scheme (crate::settings::effective_dark). A
    // function, not a `changed` handler, so Theme.dark is current as soon as it returns.
    public function set-dark(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    // Scrolls the app list so the row at `y` (its top in the list), `h` tall, is fully visible.
    public function ensure-row-visible(y: length, h: length) {
        list.ensure-visible(y, h);
    }

    // has-hover only re-evaluates on the next pointer event, so release the list freeze explicitly
    // when a modal opens and re-evaluate it when the modal closes.
    // A modal disables every control beneath it; a disabled Button ignores its focus-out, so the
    // keyboard focus (and its list freeze) is dropped explicitly as well.
    changed modal-open => {
        root.list-hover(!root.modal-open && list.hovered);
        if (root.modal-open) {
            root.clear-key-focus();
            // The graph's hover, like the list's, would only clear on the next pointer event.
            root.scrub(-1);
        }
    }

    // Open a modal only through these: focus is parked first, while the controls beneath are
    // still enabled, so a focused row button gets a real focus-out (no stale focus ring, and
    // tabbing back onto it reports focus again).
    public function show-confirm(text: string) {
        parking.focus();
        root.confirm-text = text;
        root.confirm-visible = true;
    }
    public function show-details(text: string) {
        parking.focus();
        root.details-text = text;
        root.details-visible = true;
    }
    public function show-run-task() {
        parking.focus();
        root.run-task-command = "";
        root.run-task-working-dir = "";
        root.run-task-visible = true;
    }
    // Leaving the Overview: the hidden list or row control gives up keyboard focus at once (Slint
    // drops focus from a hidden item only on a later event-loop turn).
    public function park-focus() {
        parking.focus();
    }
    // Holds keyboard focus whenever no control has it (from startup on, and after Esc in the list):
    // with no focus at all, Slint drops every key but Tab and Esc.
    parking := FocusScope {
        width: 0px;
        height: 0px;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        // The menu key (or Shift+F10) with nothing focused only brings the list into focus, ring on
        // its current row; never a menu for a row the user hasn't seen highlighted (R9-R11). The
        // next press, now in the list, opens that row's menu.
        key-pressed(e) => {
            if ((e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift)) && root.page == 0 && !root.modal-open) {
                list.focus-list();
                return accept;
            }
            if (e.text == "f" && e.modifiers.control && root.page == 0 && !root.modal-open) {
                list.focus-search();
                return accept;
            }
            return reject;
        }
    }
    init => {
        parking.focus();
    }

    HorizontalLayout {
        Rail {
            page: root.page;
            interactive: !root.modal-open;
            select(p) => { root.select-page(p); }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            // An update offer shows over every page: the startup check finds it wherever the user
            // is, and the manual one is made from Settings.
            if root.update-banner != "" : VerticalLayout {
                padding: 12px;
                padding-bottom: 0px;
                Banner {
                    text: root.update-banner;
                    action-text: "Update";
                    interactive: !root.modal-open && !root.update-busy;
                    act => { root.update-accepted(); }
                    dismiss => { root.update-dismissed(); }
                }
            }
            // Pages are stacked, not laid out (an invisible element still takes layout space): a
            // hidden page keeps its state (scroll position, search text, selection) and gets no input.
            Rectangle {
                vertical-stretch: 1;
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: root.page == 0;
                    VerticalLayout {
                        padding: 12px;
                        padding-bottom: 12px + root.toast-inset;
                        spacing: 10px;
                        if root.show-admin-banner : Banner {
                            interactive: !root.modal-open;
                            act => { root.restart-admin(); }
                            dismiss => { root.dismiss-banner(); }
                        }
                        meters-row := MetersRow {
                            meters: root.meters;
                            selected: root.selected-metric;
                            interactive: !root.modal-open;
                            select(i) => { root.select-metric(i); }
                        }
                        TopStrip {
                            tiles: root.tiles;
                            caption: root.top-caption;
                            smooth: root.settings-smooth-graphs;
                            interactive: !root.modal-open;
                            // Opening a tile clears the filter, so the box must be emptied together with it.
                            open(id) => { root.search-text = ""; root.open-tile(id); }
                        }
                        list := AppList {
                            vertical-stretch: 1;
                            rows: root.rows;
                            metric: root.selected-metric;
                            sort-column: root.sort-column;
                            sort-descending: root.sort-descending;
                            sort-clicked(c) => { root.sort-clicked(c); }
                            col-pid: root.col-pid;
                            col-proc-name: root.col-proc-name;
                            col-status: root.col-status;
                            col-threads: root.col-threads;
                            col-handles: root.col-handles;
                            col-publisher: root.col-publisher;
                            toggle-column(c) => { root.toggle-column(c); }
                            open-run-task => { root.show-run-task(); }
                            search-text <=> root.search-text;
                            interactive: !root.modal-open;
                            toggle(id) => { root.toggle-row(id); }
                            action(name, id) => { root.row-action(name, id); }
                            hover(h) => { root.list-hover(h); }
                            menu-open(open) => { root.menu-open(open); }
                            row-focus(id, focused) => { root.row-key-focus(id, focused); }
                            search(text) => { root.search-changed(text); }
                            current-row: root.current-row;
                            current-row-y: root.current-row-y;
                            current-row-h: root.current-row-h;
                            current-id: root.current-id;
                            current-actionable: root.current-actionable;
                            list-focus(f) => { root.list-focus(f); }
                            list-key(k) => { return root.list-key(k); }
                            park-focus => { parking.focus(); }
                        }
                    }
                }
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: root.page == 1;
                    perf := PerformancePage {
                        devices: root.perf-devices;
                        selected: root.perf-selected;
                        title: root.perf-title;
                        subtitle: root.perf-subtitle;
                        note: root.perf-note;
                        graphs: root.perf-graphs;
                        cells: root.perf-cells;
                        stats: root.perf-stats;
                        segments: root.perf-segments;
                        range: root.perf-range;
                        span-ms: root.perf-span-ms;
                        bottom-inset: root.toast-inset;
                        interactive: !root.modal-open;
                        select-device(id) => { root.select-device(id); }
                        select-range(i) => { root.select-range(i); }
                        scrub-x: root.scrub-x;
                        scrub-title: root.scrub-title;
                        scrub-empty: root.scrub-empty;
                        scrub-note: root.scrub-note;
                        scrub-rows: root.scrub-rows;
                        scrub(f) => { root.scrub(f); }
                    }
                }
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: root.page == 2;
                    StartupPage {
                        rows: root.startup-rows;
                        loading: root.startup-loading;
                        admin-banner: root.startup-admin-banner;
                        read-note: root.startup-read-note;
                        sort-column: root.startup-sort-column;
                        sort-descending: root.startup-sort-descending;
                        bottom-inset: root.toast-inset;
                        interactive: !root.modal-open;
                        sort-clicked(c) => { root.sort-startup(c); }
                        toggle(id, on) => { root.toggle-startup(id, on); }
                        refresh => { root.refresh-startup(); }
                        restart-admin => { root.restart-admin(); }
                    }
                }
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: root.page == 3;
                    SettingsPage {
                        refresh: root.settings-refresh;
                        theme: root.settings-theme;
                        backdrop: root.settings-backdrop;
                        always-on-top: root.on-top;
                        keep-in-tray: root.settings-keep-in-tray;
                        smooth-graphs: root.settings-smooth-graphs;
                        group-by-type: root.settings-group-by-type;
                        tray-cpu: root.settings-tray-cpu;
                        picker-shortcut: root.settings-picker-shortcut;
                        shortcut-taken: root.settings-shortcut-taken;
                        gpu-rendering: root.settings-gpu-rendering;
                        gpu-fallback: root.settings-gpu-fallback;
                        gpu-running: root.settings-gpu-running;
                        gpu-env-override: root.settings-gpu-env-override;
                        pawnio-installed: root.settings-pawnio-installed;
                        installed: root.settings-installed;
                        admin-mode-state: root.settings-admin-mode-state;
                        hotkey: root.settings-hotkey;
                        start-with-windows: root.settings-start-with-windows;
                        check-updates: root.settings-check-updates;
                        update-status: root.settings-update-status;
                        version-text: root.version-text;
                        aequilibrium-enabled: root.settings-aequilibrium-enabled;
                        aequilibrium-toggled(on) => { root.settings-aequilibrium-toggled(on); }
                        bottom-inset: root.toast-inset;
                        interactive: !root.modal-open;
                        refresh-chosen(i) => { root.refresh-chosen(i); }
                        theme-chosen(i) => { root.theme-chosen(i); }
                        backdrop-chosen(i) => { root.backdrop-chosen(i); }
                        always-on-top-toggled(on) => { root.always-on-top-toggled(on); }
                        tray-toggled(on) => { root.tray-toggled(on); }
                        smooth-graphs-toggled(on) => { root.smooth-graphs-toggled(on); }
                        group-by-type-toggled(on) => { root.group-by-type-toggled(on); }
                        tray-cpu-toggled(on) => { root.tray-cpu-toggled(on); }
                        picker-shortcut-toggled(on) => { root.picker-shortcut-toggled(on); }
                        gpu-rendering-toggled(on) => { root.gpu-rendering-toggled(on); }
                        admin-mode-toggled(on) => { root.admin-mode-toggled(on); }
                        hotkey-toggled(on) => { root.hotkey-toggled(on); }
                        start-with-windows-toggled(on) => { root.start-with-windows-toggled(on); }
                        check-updates-toggled(on) => { root.check-updates-toggled(on); }
                        check-updates-now() => { root.check-updates-now(); }
                        open-windows-task-manager() => { root.open-windows-task-manager(); }
                    }
                }
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: root.page == 4;
                    AppHistoryPage {
                        rows: root.history-rows;
                        duration-text: root.history-duration;
                        sort-column: root.history-sort-column;
                        sort-descending: root.history-sort-descending;
                        bottom-inset: root.toast-inset;
                        interactive: !root.modal-open;
                        sort-clicked(c) => { root.sort-history(c); }
                        reset => { root.reset-history(); }
                    }
                }
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    visible: root.page == 5;
                    ServicesPage {
                        rows: root.service-rows;
                        loading: root.services-loading;
                        search-text <=> root.services-search-text;
                        sort-column: root.services-sort-column;
                        sort-descending: root.services-sort-descending;
                        bottom-inset: root.toast-inset;
                        interactive: !root.modal-open;
                        search(text) => { root.search-services(text); }
                        sort-clicked(c) => { root.sort-services(c); }
                        refresh => { root.refresh-services(); }
                        service-action(act, id) => { root.service-action(act, id); }
                    }
                }
                // Over every page: a result (a failed startup toggle, an action's message) shows
                // wherever the user is. Its host is empty (zero height) without a toast.
                toast-host := VerticalLayout {
                    x: 12px;
                    width: parent.width - 24px;
                    height: self.preferred-height;
                    y: parent.height - self.height - 12px;
                    if root.toast != "" : Toast {
                        text: root.toast;
                        interactive: !root.modal-open;
                        dismiss => { root.dismiss-toast(); }
                    }
                }
            }
        }
    }
    if root.confirm-visible : Modal {
        title: "End a critical system process?";
        body: root.confirm-text;
        confirm-label: "End process";
        cancel-primary: true;
        done(ok) => { root.confirm(ok); }
    }
    if root.details-visible : Modal {
        title: "Details";
        body: root.details-text;
        confirm-label: "Close";
        show-cancel: false;
        done(ok) => { root.close-details(); }
    }
    if root.run-task-visible : RunTaskModal {
        command <=> root.run-task-command;
        working-dir <=> root.run-task-working-dir;
        sandbox-available: root.windows-sandbox-available;
        browse => { root.browse-executable(); }
        enable-sandbox-terminal => { root.enable-windows-sandbox-terminal(); }
        copy-sandbox-cmd => { root.copy-windows-sandbox-cmd(); }
        run(cmd, dir, priv-mode, compat, eco) => {
            root.run-task-visible = false;
            root.run-new-task(cmd, dir, priv-mode, compat, eco);
        }
        cancel => {
            root.run-task-visible = false;
        }
    }
    if root.affinity-visible : CpuAffinityModal {
        title: root.affinity-title;
        process-name: root.affinity-process-name;
        cores <=> root.affinity-cores;
        all-cores <=> root.affinity-all-cores;
        can-apply: root.affinity-can-apply;
        remember <=> root.affinity-remember;
        toggle-core(id) => { root.affinity-toggle-core(id); }
        toggle-all(on) => { root.affinity-toggle-all(on); }
        apply(rem) => { root.affinity-apply(rem); }
        cancel => { root.affinity-cancel(); }
    }
    if root.priority-visible : CpuPriorityModal {
        title: root.priority-title;
        process-name: root.priority-process-name;
        selected <=> root.priority-selected;
        remember <=> root.priority-remember;
        apply(sel, rem) => { root.priority-apply(sel, rem); }
        cancel => { root.priority-cancel(); }
    }
}
