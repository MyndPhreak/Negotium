import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <color> accent: #0078d4;
    in-out property <bool> mica: false;
    // The chosen backdrop is Acrylic (crate::platform::set_backdrop).
    in-out property <bool> acrylic: false;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // Which palette the text and surfaces use (P2 stub: the mode; the palette colours still read `dark`).
    out property <bool> palette-dark: dark;
    property <color> solid-bg: dark ? #202020 : #f3f3f3;
    // Settings > Tint colour and Tint opacity (crate::settingspage::show_settings): the chosen
    // colour (`tint-color-set` false: the mode's own) and opacity in percent (-1: the mode's own).
    in-out property <bool> tint-color-set: false;
    in-out property <color> tint-color: #000000;
    in-out property <int> tint-opacity: -1;
    // What the Settings page shows: the mode's own tint colour, and the opacity in effect (percent).
    out property <color> tint-default: dark ? #000000 : solid-bg;
    out property <int> tint-percent: round(tint-alpha * 100);
    // Acrylic alone shows too much of the windows behind: a part-opaque layer softens it, black in
    // dark mode and the solid colour in light. Light needs a firmer layer: grey text on it can only
    // be as dark as the layer lets it, and at 45% the labels broke up over a busy background. Mica
    // only tints from the wallpaper and is shown as it is. A chosen colour or opacity replaces the
    // mode's own in both modes; unset, the old values apply unchanged.
    property <float> tint-alpha: tint-opacity >= 0 ? tint-opacity / 100 : (dark ? 0.45 : 0.8);
    property <color> acrylic-tint: (tint-color-set ? tint-color : tint-default).with-alpha(tint-alpha);
    out property <brush> window-bg: mica ? (acrylic ? acrylic-tint : transparent) : solid-bg;
    out property <color> card: dark ? #ffffff0f : #ffffffb3;
    out property <color> card-border: dark ? #ffffff14 : #0000000f;
    // A hovered card: a step lighter than `card`.
    out property <color> card-hover: dark ? #ffffff17 : #ffffffff;
    // Laid over `card` for the process strip inside an expanded card: a shade darker.
    out property <color> card-inset: dark ? #0000002e : #00000008;
    out property <color> text: dark ? #ffffff : #1a1a1a;
    out property <color> muted: dark ? #ffffffa0 : #00000099;
    out property <color> danger-text: dark ? #ff99a4 : #c42b1c;
    out property <color> danger-bg: dark ? #442726 : #fde7e9;
    // A destructive control's fill under the pointer (the End task ×), and what is drawn on it.
    out property <color> danger: dark ? #c42b1c : #d13438;
    out property <color> on-danger: #ffffff;
    // Text drawn on an accent fill: dark on a light accent, white otherwise (perceived luminance).
    out property <color> on-accent: (accent.red * 0.299 + accent.green * 0.587 + accent.blue * 0.114) > 150 ? #000000 : #ffffff;
    out property <length> radius: 8px;
    // Negotium's caption buttons (titlebar.slint): the Windows 11 caption's fills under the
    // pointer and pressed, and close's red (the same in both modes).
    out property <color> caption-hover: dark ? #ffffff0f : #0000000a;
    out property <color> caption-press: dark ? #ffffff0a : #00000006;
    out property <color> caption-close: #c42b1c;
}
