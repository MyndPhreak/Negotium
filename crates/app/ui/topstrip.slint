import { Theme } from "theme.slint";
import { FocusButton } from "focusbutton.slint";
import { GraphClock } from "graph.slint";

// `leaving`: gone from the top this frame; it shrinks away and the bridge drops it next frame.
export struct TileData { id: int, name: string, value: string, weight: float, hung: bool, leaving: bool }

export component TopStrip inherits VerticalLayout {
    in property <[TileData]> tiles;
    in property <string> caption;
    in property <bool> interactive: true;
    // Tiles glide to their new widths instead of jumping each frame (Settings > Smooth graphs).
    in property <bool> smooth: true;
    callback open(int);
    // The glide rides the graph clock (crate::smooth, GraphClock in graph.slint): a tile's
    // progress is the time GraphClock.now has advanced since the frame landed, over `glide-ms`,
    // eased out. So tiles move only on the redraws the scrolling graphs make anyway, a few coarse
    // steps a glide, and never ask for one themselves. A timer or an `animate` of their own cost
    // a redraw per step, and the winit backend presents every isolated redraw twice: one step per
    // pixel presented about 61 frames a second, eight steps 24 (redraw-debug-report).
    // Tiles glide only while the graph clock moves: smoothing on, the window on screen and a run
    // in progress (GraphClock.offset-ms < 0, as main.slint's scroll timer). Otherwise every tile
    // sits on its target, so a run that stops early, or never starts, never leaves one part-way:
    // the redraw that stops the clock, or the frame's own, shows it there.
    out property <bool> live: root.smooth && GraphClock.shown;
    out property <bool> moving: root.live && GraphClock.live && GraphClock.offset-ms < 0;
    property <duration> glide-ms: 450ms;
    vertical-stretch: 0; // see MetersRow: spare height belongs to the app list
    spacing: 4px;
    Text { text: caption; color: Theme.muted; font-size: 11px; }
    HorizontalLayout {
        height: 52px;
        max-width: 16384px; // see MetersRow: empty repeaters must not cap the window width
        spacing: 4px;
        for t in tiles : FocusButton {
            // A new tile grows from nothing: `born` turns on a moment after it is created, so the
            // change animates (a value set at creation would not).
            property <bool> born: false;
            property <bool> present: self.born && !t.leaving;
            Timer {
                interval: 1ms;
                running: !parent.born;
                triggered => { parent.born = true; }
            }
            // Where the tile is going (stretch, and 1 shown / 0 gone) and where its glide started.
            property <float> target: self.present ? max(t.weight, 0.0001) : 0.0001;
            property <float> target-shown: self.present ? 1 : 0;
            property <float> from: 0.0001;
            property <float> to: 0.0001;
            property <float> from-shown: 0;
            property <float> to-shown: 0;
            property <duration> start;
            property <float> progress: clamp((GraphClock.now - self.start) / root.glide-ms, 0, 1);
            property <float> eased: 1 - (1 - self.progress) * (1 - self.progress); // ease-out
            property <float> stretch: root.moving ? self.from + (self.to - self.from) * self.eased : self.target;
            property <float> shown: root.moving ? self.from-shown + (self.to-shown - self.from-shown) * self.eased : self.target-shown;
            property <bool> moving: root.moving;
            changed target => { self.glide(); }
            changed target-shown => { self.glide(); }
            changed moving => { self.glide(); }
            // A frame changed the tile (or the clock started or stopped): it glides from where it
            // is shown, starting now on the graph clock; with the clock still it sits on its target.
            function glide() {
                self.from = root.moving ? self.stretch : self.target;
                self.from-shown = root.moving ? self.shown : self.target-shown;
                self.to = self.target;
                self.to-shown = self.target-shown;
                self.start = GraphClock.now;
            }
            horizontal-stretch: self.stretch;
            min-width: 28px * self.shown;
            opacity: self.shown;
            clip: true;
            border-radius: 6px;
            background: t.hung ? Theme.danger-bg : Theme.accent.with-alpha(0.28);
            border-width: self.focused ? 2px : 0px;
            border-color: Theme.text;
            accessible-label: t.name + " tile";
            interactive: root.interactive && !t.leaving;
            activated => { root.open(t.id); }
            VerticalLayout {
                padding: 6px;
                Text { text: (t.hung ? "⚠ " : "") + t.name; color: Theme.text; font-size: 12px; overflow: elide; }
                Text { text: t.value; color: Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
            }
        }
    }
}
