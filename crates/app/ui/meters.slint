import { Theme } from "theme.slint";
import { FocusButton } from "focusbutton.slint";

export struct MeterData { label: string, value: string, sub: string, spark: string, available: bool }

component Meter inherits FocusButton {
    in property <MeterData> data;
    in property <bool> selected;
    min-width: 96px;
    border-radius: Theme.radius;
    background: selected ? Theme.accent.with-alpha(0.18) : Theme.card;
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.text : (selected ? Theme.accent : Theme.card-border);
    accessible-label: data.label + " meter";
    accessible-checkable: true;
    accessible-checked: root.selected;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text { text: data.label; color: Theme.muted; font-size: 12px; }
        Text { text: data.available ? data.value : "Unavailable"; color: Theme.text; font-size: data.available ? 20px : 14px; font-weight: 600; }
        Text { text: data.sub; color: Theme.muted; font-size: 11px; }
        Path {
            height: 26px;
            commands: data.spark;
            viewbox-width: 1000;
            fill: transparent;
            viewbox-height: 100;
            stroke: Theme.accent;
            stroke-width: 1.5px;
        }
    }
}

export component MetersRow inherits HorizontalLayout {
    in property <[MeterData]> meters;
    in property <int> selected;
    in property <bool> interactive: true;
    callback select(int);
    // An empty repeater derives a maximum width below the window's min-width, which clamped the
    // window to min-width and made it ignore preferred-width. An explicit cap overrides that.
    max-width: 16384px;
    // Natural height only: spare window height goes to the app list. Without this the meters
    // soaked it up once the top strip filled, growing a second after the app opened.
    vertical-stretch: 0;
    spacing: 8px;
    for m[i] in meters : Meter {
        data: m;
        selected: i == root.selected;
        interactive: root.interactive;
        activated => { root.select(i); }
    }
}
