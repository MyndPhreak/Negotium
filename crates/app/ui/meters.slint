import { Theme } from "theme.slint";
import { FocusButton } from "focusbutton.slint";
import { DataPath } from "graph.slint";

export struct MeterData { label: string, value: string, sub: string, spark: string, available: bool }

component Meter inherits FocusButton {
    in property <MeterData> data;
    in property <bool> selected;
    min-width: 96px;
    // Every meter asks for the same width, so the row splits evenly and a longer value (as the
    // Network rate's) does not widen its card.
    preferred-width: 96px;
    border-radius: Theme.radius;
    background: selected ? Theme.accent.with-alpha(0.18) : Theme.card;
    border-width: root.focus-visible ? 2px : 1px;
    border-color: root.focus-visible ? Theme.text : (selected ? Theme.accent : Theme.card-border);
    accessible-label: data.label + " meter";
    accessible-checkable: true;
    accessible-checked: root.selected;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text { text: data.label; color: Theme.muted; font-size: 12px; overflow: elide; }
        Text { text: data.available ? data.value : "Unavailable"; color: Theme.text; font-size: data.available ? 20px : 14px; font-weight: 600; overflow: elide; }
        Text { text: data.sub; color: Theme.muted; font-size: 11px; overflow: elide; }
        DataPath {
            height: 26px;
            commands: data.spark;
            stroke: Theme.accent;
        }
    }
}

export component MetersRow inherits HorizontalLayout {
    in property <[MeterData]> meters;
    in property <int> selected;
    in property <bool> interactive: true;
    callback select(int);
    // An empty repeater derives a maximum width below the window's min-width, which clamped the
    // window to min-width and made it ignore preferred-width. An explicit cap overrides that.
    max-width: 16384px;
    // Natural height only: spare window height goes to the app list. Without this the meters
    // soaked it up once the top strip filled, growing a second after the app opened.
    vertical-stretch: 0;
    spacing: 8px;
    // About how wide each sparkline is (a meter less its 10 px padding each side), for the graph
    // timer's interval.
    out property <length> spark-width: (self.width - (root.meters.length - 1) * 8px) / max(1, root.meters.length) - 20px;
    for m[i] in meters : Meter {
        data: m;
        selected: i == root.selected;
        interactive: root.interactive;
        activated => { root.select(i); }
    }
}
