import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ScrollIndicator } from "scrollindicator.slint";
import { SortHeader } from "applist.slint";
import { FocusButton } from "focusbutton.slint";

export struct ServiceData {
    id: int,
    name: string,
    pid: string,
    pid-num: int,
    description: string,
    status: string,
    group: string,
    start-type: string,
    running: bool,
    can-stop: bool,
}

export component ServicesPage inherits VerticalLayout {
    in property <[ServiceData]> rows;
    in property <bool> loading;
    in-out property <string> search-text;
    in property <int> sort-column: 0;
    in property <bool> sort-descending: false;
    in property <length> bottom-inset;
    in property <bool> interactive: true;
    out property <int> menu-target: -1;
    out property <bool> menu-running: false;
    out property <bool> menu-can-stop: false;
    out property <int> menu-pid: 0;
    callback search(string);
    callback sort-clicked(int);
    callback refresh();
    callback service-action(string, int);
    property <length> pid-w: 68px;
    property <length> status-w: 88px;
    property <length> group-w: 130px;
    property <length> start-w: 96px;
    property <length> gutter: 14px;
    max-width: 16384px;
    padding: 12px;
    padding-bottom: 12px + root.bottom-inset;
    spacing: 10px;

    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 12px;
        Text {
            text: "Services";
            color: Theme.text;
            font-size: 24px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.loading && root.rows.length > 0 : Text {
            text: "Updating…";
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        Button { text: "Refresh"; enabled: root.interactive; clicked => { root.refresh(); } }
    }
    Rectangle {
        vertical-stretch: 0;
        height: svc-search.preferred-height;
        svc-search := LineEdit {
            width: parent.width;
            text <=> root.search-text;
            placeholder-text: "Search services by name, description, PID, or group";
            accessible-label: "Search services";
            enabled: root.interactive;
            edited(text) => { root.search(text); }
        }
        if root.search-text != "" : FocusButton {
            x: parent.width - 28px;
            y: (parent.height - 22px) / 2;
            width: 22px;
            height: 22px;
            border-radius: 4px;
            interactive: root.interactive;
            accessible-label: "Clear service search";
            background: self.hovered ? Theme.card-hover : transparent;
            activated => {
                root.search-text = "";
                root.search("");
            }
            Path {
                width: 8px;
                height: 8px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-width: 8;
                viewbox-height: 8;
                commands: "M 1 1 L 7 7 M 7 1 L 1 7";
                stroke: Theme.muted;
                stroke-width: 1.4px;
                fill: transparent;
            }
        }
    }
    HorizontalLayout {
        vertical-stretch: 0;
        height: 24px;
        padding-left: 8px;
        padding-right: 8px + root.gutter;
        spacing: 8px;
        SortHeader {
            label: "Name";
            left: true;
            width: 160px;
            sorted: root.sort-column == 0;
            descending: root.sort-descending;
            interactive: root.interactive;
            activated => { root.sort-clicked(0); }
        }
        SortHeader {
            label: "PID";
            width: root.pid-w;
            sorted: root.sort-column == 1;
            descending: root.sort-descending;
            interactive: root.interactive;
            activated => { root.sort-clicked(1); }
        }
        SortHeader {
            label: "Description";
            left: true;
            horizontal-stretch: 1;
            sorted: root.sort-column == 2;
            descending: root.sort-descending;
            interactive: root.interactive;
            activated => { root.sort-clicked(2); }
        }
        SortHeader {
            label: "Status";
            left: true;
            width: root.status-w;
            sorted: root.sort-column == 3;
            descending: root.sort-descending;
            interactive: root.interactive;
            activated => { root.sort-clicked(3); }
        }
        SortHeader {
            label: "Group";
            left: true;
            width: root.group-w;
            sorted: root.sort-column == 4;
            descending: root.sort-descending;
            interactive: root.interactive;
            activated => { root.sort-clicked(4); }
        }
        SortHeader {
            label: "Startup type";
            left: true;
            width: root.start-w;
            sorted: root.sort-column == 5;
            descending: root.sort-descending;
            interactive: root.interactive;
            activated => { root.sort-clicked(5); }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        svc-menu := ContextMenuArea {
            enabled: false;
            Menu {
                MenuItem {
                    title: "Start";
                    enabled: !root.menu-running;
                    activated => { root.service-action("start", root.menu-target); }
                }
                MenuItem {
                    title: "Stop";
                    enabled: root.menu-running && root.menu-can-stop;
                    activated => { root.service-action("stop", root.menu-target); }
                }
                MenuItem {
                    title: "Restart";
                    enabled: root.menu-running && root.menu-can-stop;
                    activated => { root.service-action("restart", root.menu-target); }
                }
                MenuSeparator { }
                MenuItem {
                    title: "Go to process";
                    enabled: root.menu-pid > 0;
                    activated => { root.service-action("goto", root.menu-target); }
                }
            }
        }
        lv := ScrollView {
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: max(0px, self.visible-width - root.gutter);
            content-height: column.preferred-height;
            changed content-height => {
                self.content-y = max(self.content-y, min(0px, self.visible-height - self.content-height));
            }
            column := VerticalLayout {
                width: lv.content-width;
                height: self.preferred-height;
                for r in root.rows : slot := Rectangle {
                    height: 36px;
                    property <bool> built: self.y + self.height > -lv.content-y && self.y < -lv.content-y + lv.visible-height;
                    if slot.built : Rectangle {
                        border-radius: 4px;
                        background: ta.has-hover ? Theme.card : transparent;
                        accessible-role: list-item;
                        accessible-label: r.name + ", " + r.description + ", " + r.status;
                        ta := TouchArea {
                            enabled: root.interactive;
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                    root.menu-target = r.id;
                                    root.menu-running = r.running;
                                    root.menu-can-stop = r.can-stop;
                                    root.menu-pid = r.pid-num;
                                    svc-menu.show({ x: self.mouse-x, y: slot.y + lv.content-y + self.mouse-y });
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Text {
                                text: r.name;
                                width: 160px;
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                            Text {
                                text: r.pid;
                                width: root.pid-w;
                                color: Theme.muted;
                                font-size: 12px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                            Text {
                                text: r.description;
                                horizontal-stretch: 1;
                                color: Theme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                            Text {
                                text: r.status;
                                width: root.status-w;
                                color: r.running ? Theme.accent : Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                            Text {
                                text: r.group;
                                width: root.group-w;
                                color: Theme.muted;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                            Text {
                                text: r.start-type;
                                width: root.start-w;
                                color: Theme.muted;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                        }
                    }
                }
            }
        }
        if lv.content-height > lv.visible-height : ScrollIndicator {
            x: lv.width - self.width;
            height: lv.height;
            interactive: root.interactive;
            content-y <=> lv.content-y;
            visible-height: lv.visible-height;
            content-height: lv.content-height;
        }
    }
}
