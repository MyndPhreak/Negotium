import { Button, LineEdit, ScrollView, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FocusButton } from "focusbutton.slint";
import { Choice, Toggle } from "settingspage.slint";

// An inline offer (spec 7: never a dialog): the admin path (why admin rights are needed and a
// "Restart as admin" button, on the Overview (dismissable) and the Startup page (not)), and an
// update ("Update to vX.Y.Z" with "Update" and "Dismiss", over every page).
export component Banner inherits Rectangle {
    in property <string> text: "Some processes need admin rights to show details, network use, or be ended.";
    in property <string> action-text: "Restart as admin";
    in property <bool> dismissable: true;
    in property <bool> interactive: true;
    callback act();
    callback dismiss();
    min-height: 40px;
    vertical-stretch: 0;
    border-radius: Theme.radius;
    background: Theme.accent.with-alpha(0.15);
    HorizontalLayout {
        padding: 8px;
        spacing: 8px;
        Text { text: root.text; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
        Button { text: root.action-text; enabled: root.interactive; clicked => { root.act(); } }
        if root.dismissable : Button { text: "Dismiss"; enabled: root.interactive; clicked => { root.dismiss(); } }
    }
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> interactive: true;
    callback dismiss();
    min-height: 36px;
    border-radius: Theme.radius;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-border;
    HorizontalLayout {
        padding: 8px;
        spacing: 8px;
        Text { text: root.text; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
        Button { text: "OK"; enabled: root.interactive; clicked => { root.dismiss(); } }
    }
}

export component Modal inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> confirm-label;
    in property <bool> show-cancel: true;
    // When true the safe choice (Cancel) is the primary button and the Return default.
    in property <bool> cancel-primary: false;
    callback done(bool);
    background: #00000066;
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.done(false);
                return accept;
            }
            if (event.text == Key.Return) {
                root.done(!root.cancel-primary);
                return accept;
            }
            return reject;
        }
    }
    Rectangle {
        width: min(parent.width - 48px, 520px);
        height: layout.preferred-height;
        border-radius: Theme.radius;
        background: Theme.palette-dark ? #2b2b2b : #ffffff;
        layout := VerticalLayout {
            padding: 16px;
            spacing: 12px;
            Text { text: root.title; color: Theme.text; font-size: 16px; font-weight: 600; }
            Text { text: root.body; color: Theme.text; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                if root.show-cancel : Button { text: "Cancel"; primary: root.cancel-primary; clicked => { root.done(false); } }
                Button { text: root.confirm-label; primary: !root.cancel-primary; clicked => { root.done(true); } }
            }
        }
    }
}

export component RunTaskModal inherits Rectangle {
    in-out property <string> command;
    in-out property <string> working-dir;
    in-out property <int> privilege-mode: 0;
    in-out property <int> compat-mode: 0;
    in-out property <bool> efficiency-mode: false;
    callback run(string, string, int, int, bool);
    callback cancel();
    callback browse();
    in property <bool> sandbox-available: true;
    callback enable-sandbox-terminal();
    callback copy-sandbox-cmd();
    background: #00000066;
    TouchArea { }
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.text == Key.Return && (root.command != "" || root.privilege-mode == 3)) {
                root.run(root.command, root.working-dir, root.privilege-mode, root.compat-mode, root.efficiency-mode);
                return accept;
            }
            return reject;
        }
    }
    Rectangle {
        width: min(parent.width - 48px, 560px);
        height: layout.preferred-height;
        border-radius: Theme.radius;
        background: Theme.palette-dark ? #2b2b2b : #ffffff;
        border-width: 1px;
        border-color: Theme.card-border;
        layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text { text: "Run new task"; color: Theme.text; font-size: 18px; font-weight: 600; }
            Text { text: "Type the name of a program, folder, document, or command with arguments."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
            VerticalLayout {
                spacing: 4px;
                Text { text: "Open"; color: Theme.text; font-size: 12px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 8px;
                    cmd-input := LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.command;
                        placeholder-text: "e.g. cmd.exe, powershell, notepad C:\\notes.txt";
                        accessible-label: "Command or path to run";
                        init => { self.focus(); }
                        accepted => {
                            if (root.command != "") {
                                root.run(root.command, root.working-dir, root.privilege-mode, root.compat-mode, root.efficiency-mode);
                            }
                        }
                    }
                    Button {
                        text: "Browse...";
                        clicked => { root.browse(); }
                    }
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text { text: "Start in (optional working folder)"; color: Theme.text; font-size: 12px; font-weight: 600; }
                LineEdit {
                    text <=> root.working-dir;
                    placeholder-text: "Default working folder";
                    accessible-label: "Working folder";
                }
            }
            VerticalLayout {
                spacing: 6px;
                Text { text: "Privilege & security level"; color: Theme.text; font-size: 12px; font-weight: 600; }
                Choice {
                    label: "Privilege level";
                    description: "Normal, Administrator, Standard User (de-elevated), or Windows Sandbox";
                    options: ["Normal", "Admin (Elevated)", "Standard User", "Windows Sandbox"];
                    selected: root.privilege-mode;
                    chosen(i) => { root.privilege-mode = i; }
                }
                Text {
                    text: root.privilege-mode == 1 ? "Runs with full administrative privileges (prompts for UAC if needed)."
                        : root.privilege-mode == 2 ? "Drops administrative rights and runs as a restricted standard user token."
                        : root.privilege-mode == 3 ? "Runs inside an isolated, disposable Windows Sandbox virtual machine (read-only host folder)."
                        : "Runs with Negotium's current user privileges.";
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                if root.privilege-mode == 3 && !root.sandbox-available : Rectangle {
                    background: Theme.accent.with-alpha(0.12);
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.3);
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text {
                            text: "Windows Sandbox is not enabled on this PC.";
                            color: Theme.text;
                            font-size: 11px;
                            font-weight: 600;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Run in Terminal (Admin)";
                                clicked => { root.enable-sandbox-terminal(); }
                            }
                            Button {
                                text: "Copy Command";
                                clicked => { root.copy-sandbox-cmd(); }
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Text { text: "Compatibility layer"; color: Theme.text; font-size: 12px; font-weight: 600; }
                Choice {
                    label: "Compatibility mode";
                    description: "Windows compatibility shims applied to the launched process";
                    options: ["None", "Windows 8", "Windows 7", "High DPI Aware"];
                    selected: root.compat-mode;
                    chosen(i) => { root.compat-mode = i; }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: "Start in Efficiency mode (EcoQoS)"; color: Theme.text; font-size: 12px; font-weight: 600; }
                    Text { text: "Launches at low CPU priority and power throttling."; color: Theme.muted; font-size: 11px; }
                }
                VerticalLayout {
                    alignment: center;
                    Toggle {
                        label: "Start in Efficiency mode";
                        description: "Launches at low CPU priority and power throttling";
                        checked: root.efficiency-mode;
                        toggled(on) => { root.efficiency-mode = on; }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Button {
                    text: "Run";
                    primary: true;
                    enabled: root.command != "" || root.privilege-mode == 3;
                    clicked => {
                        root.run(root.command, root.working-dir, root.privilege-mode, root.compat-mode, root.efficiency-mode);
                    }
                }
            }
        }
    }
}

export struct CoreItem {
    id: int,
    checked: bool,
}

// A CCD or core class (unnamed when the machine has neither) and its logical processors.
export struct CoreGroup {
    name: string,
    detail: string,
    checked: bool,
    cores: [CoreItem],
}

// A drawn check box (the ballot box glyphs do not exist in every font).
component CheckMark inherits Rectangle {
    in property <bool> checked;
    width: 16px;
    height: 16px;
    border-radius: 3px;
    background: root.checked ? Theme.accent : transparent;
    border-width: root.checked ? 0px : 1px;
    border-color: Theme.muted;
    if root.checked : Path {
        width: 10px;
        height: 8px;
        viewbox-width: 10;
        viewbox-height: 8;
        commands: "M 0.5 4 L 3.75 7 L 9.5 1";
        stroke: Theme.on-accent;
        stroke-width: 1.75px;
        fill: transparent;
    }
}

// A check box row: the remember-as-rule row and each CPU group header.
component CheckRow inherits FocusButton {
    in property <string> text;
    in property <string> detail;
    in property <bool> checked;
    min-height: 32px;
    border-radius: 4px;
    background: root.hovered ? Theme.text.with-alpha(0.06) : transparent;
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.text;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-description: root.detail;
    accessible-checkable: true;
    accessible-checked: root.checked;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            CheckMark { checked: root.checked; }
        }
        Text { text: root.text; color: Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
        Text { text: root.detail; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
    }
}

// One logical processor: filled with the accent colour when the process can use it.
component CpuTile inherits FocusButton {
    in property <int> cpu;
    in property <bool> checked;
    height: 30px;
    border-radius: 4px;
    background: root.checked ? (root.hovered ? Theme.accent.brighter(0.15) : Theme.accent) : (root.hovered ? Theme.card-hover : Theme.card-inset);
    border-width: root.focused ? 2px : 1px;
    border-color: root.focused ? Theme.text : (root.checked ? Theme.accent : Theme.card-border);
    accessible-role: checkbox;
    accessible-label: "CPU " + root.cpu;
    accessible-checkable: true;
    accessible-checked: root.checked;
    Text {
        text: root.cpu;
        color: root.checked ? Theme.on-accent : Theme.muted;
        font-size: 12px;
        font-weight: root.checked ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component CpuAffinityModal inherits Rectangle {
    in property <string> title: "Set CPU Affinity";
    in property <string> process-name: "";
    in property <[CoreGroup]> groups: [];
    // "8 of 32 selected".
    in property <string> selected-text: "";
    in-out property <bool> all-cores: true;
    in-out property <bool> remember: false;
    callback toggle-core(int);
    callback toggle-group(int);
    callback toggle-all(bool);
    callback apply(bool);
    callback cancel();

    in property <bool> can-apply: true;
    property <int> columns: 8;
    property <length> gap: 4px;

    background: #00000066;
    TouchArea { }
    // The dialog sits inside the scope, so Escape and Return reach it from a focused tile too.
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.text == Key.Return && root.can-apply) {
                root.apply(root.remember);
                return accept;
            }
            return reject;
        }
        Rectangle {
            width: min(root.width - 48px, 520px);
            height: layout.preferred-height;
            border-radius: Theme.radius;
            background: Theme.palette-dark ? #2b2b2b : #ffffff;
            border-width: 1px;
            border-color: Theme.card-border;
            layout := VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: "Select the CPUs that the process can use.";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                // All processors row
                Rectangle {
                    height: 44px;
                    border-radius: 4px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: "All processors"; color: Theme.text; font-size: 13px; font-weight: 600; }
                            Text { text: root.selected-text; color: Theme.muted; font-size: 11px; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                label: "All processors";
                                description: root.selected-text;
                                checked: root.all-cores;
                                toggled(on) => { root.toggle-all(on); }
                            }
                        }
                    }
                }

                // A header and a grid of tiles per CCD or core class
                Rectangle {
                    border-radius: 4px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 10px;
                        for group[gi] in root.groups : VerticalLayout {
                            spacing: 6px;
                            if group.name != "" : CheckRow {
                                text: group.name;
                                detail: group.detail;
                                checked: group.checked;
                                activated => { root.toggle-group(gi); }
                            }
                            grid := Rectangle {
                                property <length> tile-width: (self.width - (root.columns - 1) * root.gap) / root.columns;
                                height: ceil(group.cores.length / root.columns) * (30px + root.gap) - root.gap;
                                for core[ci] in group.cores : CpuTile {
                                    x: mod(ci, root.columns) * (grid.tile-width + root.gap);
                                    y: floor(ci / root.columns) * (30px + root.gap);
                                    width: grid.tile-width;
                                    cpu: core.id;
                                    checked: core.checked;
                                    activated => { root.toggle-core(core.id); }
                                }
                            }
                        }
                    }
                }

                // Remember row
                if root.process-name != "" : Rectangle {
                    border-radius: 4px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    HorizontalLayout {
                        padding: 2px;
                        CheckRow {
                            text: "Remember for " + root.process-name;
                            detail: "Keep as a rule";
                            checked: root.remember;
                            activated => { root.remember = !root.remember; }
                        }
                    }
                }

                // Action buttons
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.cancel(); }
                    }
                    Button {
                        text: "Apply";
                        primary: true;
                        enabled: root.can-apply;
                        clicked => {
                            root.apply(root.remember);
                        }
                    }
                }
            }
        }
    }
}

export component CpuPriorityModal inherits Rectangle {
    in property <string> title: "Set CPU Priority";
    in property <string> process-name: "";
    in-out property <int> selected: 3; // 0=Realtime, 1=High, 2=AboveNormal, 3=Normal, 4=BelowNormal, 5=Idle
    in-out property <bool> remember: false;
    callback apply(int, bool);
    callback cancel();

    private property <[string]> options: [
        "Realtime (Highest)",
        "High",
        "Above normal",
        "Normal",
        "Below normal",
        "Low / Idle (Lowest)"
    ];

    background: #00000066;
    TouchArea { }
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.text == Key.Return) {
                root.apply(root.selected, root.remember);
                return accept;
            }
            return reject;
        }
    }
    Rectangle {
        width: min(parent.width - 48px, 460px);
        height: layout.preferred-height;
        border-radius: Theme.radius;
        background: Theme.palette-dark ? #2b2b2b : #ffffff;
        border-width: 1px;
        border-color: Theme.card-border;
        layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 16px;
                font-weight: 600;
            }
            Text {
                text: "Specify the priority class for the process threads.";
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }

            // Realtime warning banner
            if root.selected == 0 : Rectangle {
                border-radius: 4px;
                background: Theme.accent.with-alpha(0.12);
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.3);
                HorizontalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Text {
                        text: "⚠ Warning: Realtime priority can starve vital operating system threads and cause system instability.";
                        color: Theme.text;
                        font-size: 11px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }

            // Priority options list
            VerticalLayout {
                spacing: 4px;
                for opt[i] in root.options : Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: i == root.selected ? Theme.accent.with-alpha(0.15) : (opt-touch.has-hover ? Theme.text.with-alpha(0.06) : transparent);
                    border-width: 1px;
                    border-color: i == root.selected ? Theme.accent : transparent;
                    opt-touch := TouchArea {
                        clicked => {
                            root.selected = i;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: i == root.selected ? "●" : "○";
                            color: i == root.selected ? Theme.accent : Theme.muted;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: opt;
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: i == root.selected ? 600 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            // Remember checkbox
            if root.process-name != "" : Rectangle {
                height: 36px;
                border-radius: 4px;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.card-border;
                rem-touch := TouchArea {
                    clicked => {
                        root.remember = !root.remember;
                    }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: root.remember ? "☑" : "☐";
                        color: root.remember ? Theme.accent : Theme.muted;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Remember for " + root.process-name + " (persist as rule)";
                        color: Theme.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }

            // Action buttons
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
                Button {
                    text: "Apply";
                    primary: true;
                    clicked => {
                        root.apply(root.selected, root.remember);
                    }
                }
            }
        }
    }
}

// Settings > Tint colour > Custom colour: hue and saturation in one area, brightness on a slider.
// Its state is its own; `apply` gives the colour, `cancel` changes nothing.
export component TintPickerModal inherits Rectangle {
    in-out property <float> hue; // 0..360
    in-out property <float> saturation; // 0..1
    in-out property <float> brightness; // 0..100
    callback apply(color);
    callback cancel();
    // The colour the three give (hsv clamps saturation and brightness).
    property <color> chosen: hsv(root.hue, root.saturation, root.brightness / 100);

    // A point in the area: hue across, saturation from full at the top to none at the bottom.
    function pick(x: length, y: length) {
        root.hue = clamp(x / area.width, 0, 1) * 360;
        root.saturation = 1 - clamp(y / area.height, 0, 1);
    }

    background: #00000066;
    TouchArea { }
    // Holds the keys while the picker is open. The brightness slider takes Left and Right while it
    // has focus; every other key (Return, Esc, Up, Down) comes here.
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.text == Key.Return) {
                root.apply(root.chosen);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.hue = min(360, root.hue + 10);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.hue = max(0, root.hue - 10);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.saturation = min(1, root.saturation + 0.1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.saturation = max(0, root.saturation - 0.1);
                return accept;
            }
            return reject;
        }
        Rectangle {
            width: min(parent.width - 48px, 400px);
            height: layout.preferred-height;
            border-radius: Theme.radius;
            background: Theme.palette-dark ? #2b2b2b : #ffffff;
            border-width: 1px;
            border-color: Theme.card-border;
            layout := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: "Custom tint colour";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                }
                Text {
                    text: "Hue and saturation";
                    color: Theme.muted;
                    font-size: 12px;
                    // The area carries the same label.
                    accessible-role: none;
                }
                area := Rectangle {
                    height: 160px;
                    border-radius: 4px;
                    background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.667%, #00ff00 33.333%, #00ffff 50%, #0000ff 66.667%, #ff00ff 83.333%, #ff0000 100%);
                    accessible-role: groupbox;
                    accessible-label: "Hue and saturation";
                    accessible-value: "Hue " + round(root.hue) + ", saturation " + round(root.saturation * 100) + "%";
                    Rectangle {
                        border-radius: parent.border-radius;
                        background: @linear-gradient(180deg, #ffffff00 0%, #ffffff 100%);
                    }
                    // Brightness darkens the whole area, as it does the colour.
                    Rectangle {
                        border-radius: parent.border-radius;
                        background: #000000;
                        opacity: 1 - root.brightness / 100;
                    }
                    Rectangle {
                        x: root.hue / 360 * parent.width - self.width / 2;
                        y: (1 - root.saturation) * parent.height - self.height / 2;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        border-width: 2px;
                        border-color: #ffffff;
                        background: root.chosen;
                    }
                    TouchArea {
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.pick(self.mouse-x, self.mouse-y);
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.pick(self.mouse-x, self.mouse-y);
                            }
                        }
                    }
                }
                Text {
                    text: "Brightness";
                    color: Theme.muted;
                    font-size: 12px;
                    // The slider carries the same label.
                    accessible-role: none;
                }
                Slider {
                    minimum: 0;
                    maximum: 100;
                    value <=> root.brightness;
                    accessible-label: "Brightness";
                }
                HorizontalLayout {
                    spacing: 8px;
                    // The colour Apply gives.
                    Rectangle {
                        width: 32px;
                        border-radius: 4px;
                        background: root.chosen;
                        border-width: 1px;
                        border-color: Theme.card-border;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Cancel";
                        clicked => { root.cancel(); }
                    }
                    Button {
                        text: "Apply";
                        primary: true;
                        clicked => { root.apply(root.chosen); }
                    }
                }
            }
        }
    }
}
