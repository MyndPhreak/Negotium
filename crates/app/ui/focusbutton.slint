// The one focusable button behaviour shared by meters, tiles, rail items, device and range buttons: button
// semantics, a click focuses and activates, Space or Return activates, and the screen reader's
// default action activates. Each user draws its own look from `focused` and `hovered`.
export component FocusButton inherits Rectangle {
    in property <bool> interactive: true;
    out property <bool> focused: fs.has-focus;
    // Focus that came from the keyboard: draw the focus ring from this, not from `focused`, so a
    // mouse click leaves no ring behind. A key press on the control shows it again.
    out property <bool> focus-visible: fs.has-focus && !pointer-focus;
    out property <bool> hovered: ta.has-hover;
    property <bool> pointer-focus;
    callback activated();
    // Keyboard (or click) focus arrived; a scrolling owner brings the control into view.
    callback focus-gained();
    changed focused => {
        if (root.focused) {
            root.focus-gained();
        } else {
            root.pointer-focus = false;
        }
    }
    accessible-role: button;
    // A modal disables the controls beneath it; a screen reader must not activate them either.
    accessible-action-default => {
        if (root.interactive) {
            root.activated();
        }
    }
    fs := FocusScope {
        enabled: root.interactive;
        key-pressed(event) => {
            root.pointer-focus = false;
            if (event.text == " " || event.text == Key.Return) {
                root.activated();
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.interactive;
        clicked => {
            root.pointer-focus = true;
            fs.focus();
            root.activated();
        }
    }
}
