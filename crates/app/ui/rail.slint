import { Theme } from "theme.slint";
import { FocusButton } from "focusbutton.slint";

// One rail entry: a drawn icon (glyphs render as tofu in Segoe UI Variable) over a short label.
component RailButton inherits FocusButton {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected;
    height: 48px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.accent.with-alpha(0.18) : (root.hovered ? Theme.card : transparent);
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.text;
    accessible-label: root.label + " page";
    accessible-checkable: true;
    accessible-checked: root.selected;
    if root.selected : Rectangle {
        x: 0;
        y: (parent.height - 16px) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Path {
                width: 20px;
                height: 20px;
                viewbox-width: 20;
                viewbox-height: 20;
                commands: root.icon;
                stroke: root.selected ? Theme.accent : Theme.text;
                stroke-width: 1.5px;
                fill: transparent;
            }
        }
        Text { text: root.label; color: Theme.text; font-size: 10px; horizontal-alignment: center; }
    }
}

export component Rail inherits VerticalLayout {
    in property <int> page;
    in property <bool> interactive: true;
    callback select(int);
    width: 76px;
    padding: 6px;
    // Eight buttons must fit the window's minimum height (440 less the 32 px caption).
    padding-top: 4px;
    padding-bottom: 4px;
    spacing: 1px;
    // The buttons keep their fixed height; spare height stays empty below them.
    alignment: start;
    RailButton {
        label: "Overview";
        icon: "M 2 2 L 8 2 L 8 8 L 2 8 Z M 12 2 L 18 2 L 18 8 L 12 8 Z M 2 12 L 8 12 L 8 18 L 2 18 Z M 12 12 L 18 12 L 18 18 L 12 18 Z";
        selected: root.page == 0;
        interactive: root.interactive;
        activated => { root.select(0); }
    }
    RailButton {
        label: "Performance";
        icon: "M 1 11 L 5 11 L 8 4 L 12 16 L 15 9 L 19 9";
        selected: root.page == 1;
        interactive: root.interactive;
        activated => { root.select(1); }
    }
    RailButton {
        label: "Startup";
        icon: "M 10 2 L 10 9 M 5.5 5 A 7 7 0 1 0 14.5 5";
        selected: root.page == 2;
        interactive: root.interactive;
        activated => { root.select(2); }
    }
    RailButton {
        label: "App history";
        icon: "M 10 3 A 7 7 0 1 0 17 10 A 7 7 0 0 0 10 3 M 10 6 L 10 10 L 13 12";
        selected: root.page == 4;
        interactive: root.interactive;
        activated => { root.select(4); }
    }
    RailButton {
        label: "Services";
        icon: "M 4 4 L 16 4 L 16 8 L 4 8 Z M 4 12 L 16 12 L 16 16 L 4 16 Z M 7 6 L 7.5 6 M 7 14 L 7.5 14";
        selected: root.page == 5;
        interactive: root.interactive;
        activated => { root.select(5); }
    }
    RailButton {
        label: "Ports";
        icon: "M 3 7 L 17 7 M 3 13 L 17 13 M 7 3 L 5 17 M 15 3 L 13 17";
        selected: root.page == 6;
        interactive: root.interactive;
        activated => { root.select(6); }
    }
    RailButton {
        label: "Users";
        icon: "M 10 3 A 3.5 3.5 0 1 0 10 10 A 3.5 3.5 0 1 0 10 3 M 3 17 A 7 5 0 0 1 17 17 Z";
        selected: root.page == 7;
        interactive: root.interactive;
        activated => { root.select(7); }
    }
    RailButton {
        label: "Settings";
        icon: "M 3 5 L 17 5 M 3 10 L 17 10 M 3 15 L 17 15 M 7 3 L 7 7 M 13 8 L 13 12 M 9 13 L 9 17";
        selected: root.page == 3;
        interactive: root.interactive;
        activated => { root.select(3); }
    }
}
